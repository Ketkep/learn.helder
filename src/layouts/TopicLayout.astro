---
// The shared frame for every topic page. Topics differ only inside the slot;
// the header, title, takeaways and next-topic link stay the same on purpose.
// The topic's accent color tints the top band and is available to the slot
// as the CSS variable --topic.
import BaseLayout from './BaseLayout.astro';
import { getTopic, getNextTopic, getTopicNumber } from '../data/topics';

interface Props {
  /** Must match the entry in src/data/topics.ts. Title, hook and color come from there. */
  slug: string;
  /** A short paragraph under the title. */
  intro: string;
  /** Plain sentences for the "Key takeaways" block. */
  takeaways?: string[];
}

const { slug, intro, takeaways = [] } = Astro.props;
const topic = getTopic(slug);
const next = getNextTopic(slug);
const number = getTopicNumber(slug);
---

<BaseLayout
  title={`${topic.title} | Helder Labs Learn`}
  description={topic.hook}
  band={`color-mix(in oklab, ${topic.accent} 20%, var(--paper))`}
  noindex={topic.status === 'draft'}
>
  <div style={`--topic: ${topic.accent};`}>
    <section class="head">
      <div class="wrap head-inner">
        <a class="back" href="/">
          <span aria-hidden="true">&larr;</span> All topics
        </a>
        <p class="meta">
          <span class="num">{number}</span>
          <span>{topic.category}</span>
        </p>
        <h1>{topic.title}</h1>
        <p class="intro">{intro}</p>
      </div>
    </section>

    <section class="stage wrap" aria-label="Interactive explainer">
      <div class="stage-box">
        <slot />
      </div>
    </section>

    <section class="takeaways wrap" aria-labelledby="takeaways-heading">
      <h2 id="takeaways-heading">Key takeaways</h2>
      {
        takeaways.length > 0 ? (
          <ol class="list">
            {takeaways.map((t) => (
              <li>{t}</li>
            ))}
          </ol>
        ) : (
          <p class="pending">The takeaways will appear here when the explainer is ready.</p>
        )
      }
    </section>

    <section class="more wrap">
      {
        next ? (
          <nav aria-label="Next topic" style={`--topic: ${next.accent};`}>
            <a class="next" href={`/${next.slug}/`}>
              <span class="next-label">Next topic</span>
              <span class="next-title">{next.title}</span>
              <span class="next-hook">{next.hook}</span>
              <svg class="arrow" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 12h15M13 6l6 6-6 6" />
              </svg>
            </a>
          </nav>
        ) : (
          <a class="back-bottom" href="/">
            <span aria-hidden="true">&larr;</span> Back to all topics
          </a>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .head {
    background: var(--band);
  }

  .head-inner {
    display: grid;
    gap: 1rem 3rem;
    padding-block: 0.5rem clamp(2.5rem, 6vw, 4.5rem);
  }

  .back {
    justify-self: start;
    margin-bottom: clamp(0.75rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--ink-soft);
    text-underline-offset: 0.3em;
    text-decoration-thickness: 2px;
    text-decoration-color: transparent;
    transition: color 0.15s, text-decoration-color 0.15s;
  }

  .back:hover {
    color: var(--ink);
    text-decoration-color: var(--accent);
  }

  .meta {
    display: flex;
    gap: 0.9rem;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .num {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
  }

  h1 {
    font-size: clamp(2.5rem, 1.2rem + 6vw, 5.5rem);
    font-weight: 600;
    line-height: 0.96;
    letter-spacing: -0.03em;
  }

  .intro {
    max-width: 30rem;
    color: var(--ink-soft);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.25rem);
    line-height: 1.45;
  }

  /* Title on the left, intro on the right, like the homepage hero */
  @media (min-width: 60rem) {
    .head-inner {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: end;
    }

    .back,
    .meta {
      grid-column: 1 / -1;
    }
  }

  .stage {
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .stage-box {
    min-height: 22rem;
    padding: clamp(1rem, 3vw, 2rem);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: calc(var(--radius) + 2px);
  }

  .takeaways {
    display: grid;
    gap: 1.25rem 3rem;
    padding-top: clamp(3rem, 8vw, 5.5rem);
  }

  .takeaways h2 {
    font-size: clamp(1.9rem, 1.4rem + 1.8vw, 2.75rem);
  }

  .list {
    counter-reset: takeaway;
    display: grid;
    gap: 1rem;
  }

  .list li {
    counter-increment: takeaway;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
    font-size: 1.15rem;
  }

  .list li::before {
    content: counter(takeaway, decimal-leading-zero);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--accent-text);
  }

  .pending {
    color: var(--ink-soft);
  }

  @media (min-width: 60rem) {
    .takeaways {
      grid-template-columns: 22rem minmax(0, 1fr);
      align-items: start;
    }
  }

  .more {
    padding-top: clamp(3rem, 8vw, 5.5rem);
  }

  /* The next topic is a tinted panel in that topic's own color */
  .next {
    --soft: var(--ink-soft);

    position: relative;
    display: grid;
    gap: 0.4rem;
    padding: 1.4rem 4.5rem 1.5rem 1.4rem;
    background: color-mix(in oklab, var(--topic) 20%, var(--surface));
    border-radius: calc(var(--radius) + 2px);
    text-decoration: none;
    transition: background-color 0.3s;
  }

  /* On the deeper tint the secondary text switches to full ink to stay readable */
  .next:hover,
  .next:focus-visible {
    --soft: var(--ink);
    background: color-mix(in oklab, var(--topic) 36%, var(--surface));
  }

  .next-label {
    color: var(--soft);
    font-weight: 500;
  }

  .next-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .next-hook {
    color: var(--soft);
  }

  .arrow {
    position: absolute;
    right: 1.4rem;
    top: 50%;
    transform: translateY(-50%);
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .next:hover .arrow {
      transform: translateY(-50%) translateX(5px);
    }
  }

  .back-bottom {
    font-weight: 500;
  }
</style>