---
// The whole page: a ground station console with four channels. They are the Panel components and src/scripts/gps.
// Without a script each channel shows one picture or table.
import '../../styles/gps.css';
import { intro, panels } from '../../data/gps';
import PanelRings from './PanelRings.astro';
import PanelClock from './PanelClock.astro';
import PanelSpread from './PanelSpread.astro';
import PanelEinstein from './PanelEinstein.astro';

const tools: Record<string, typeof PanelRings> = { rings: PanelRings, clock: PanelClock, spread: PanelSpread, einstein: PanelEinstein };
---

<div class="gps" data-gps>
  <section class="opening" aria-labelledby="gps-intro">
    <div class="wrap">
      <p class="kicker">Ground station</p>
      <h2 id="gps-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  <div class="wall">
    {
      panels.map((p, i) => {
        const Tool = tools[p.id];
        return (
          <section class="module" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
            <header class="module-head"><span class="chan">{i + 1}</span><p class="kicker">{p.kicker}</p></header>
            <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
            <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
            <Tool />
            {
              p.tags && (
                <div class="tags">
                  {p.tags.map((t) => (
                    <aside class="tag">
                      <p class="tag-label">{t.label}</p>
                      <p class="tag-text">{t.text}</p>
                    </aside>
                  ))}
                </div>
              )
            }
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import '../../scripts/gps/gps';
</script>
