---
// Sheet 3: drop the empty tanks. Without a script the table gives the total for one to four stages.
import { ENGINES, exhaust, fmt, NEED, stageGains, stagesSvg, total } from '../../lib/stages';
const ve = exhaust(ENGINES[0].isp);
---

<div class="tool" data-stages-tool>
  <svg class="plate" viewBox="0 0 300 126" role="img" aria-label="A bar made of one block for each stage, showing the total gain in speed, with a line at the speed needed for orbit." data-stages-svg>
    <rect class="stage" x="1" y="1" width="298" height="124" rx="8"></rect>
    <g set:html={stagesSvg(stageGains(ve, 2, 0.1, 0.02))} data-stages-g></g>
  </svg>
  <table class="times">
    <caption class="sr-only">The total gain in speed for one to four stages, with 10 per cent structure and 2 per cent payload</caption>
    <thead><tr><th scope="col">Stages</th>{ENGINES.map((e) => <th scope="col">{e.name}</th>)}</tr></thead>
    <tbody>{[1, 2, 3, 4].map((n) => <tr><th scope="row">{n}</th>{ENGINES.map((e) => <td>{fmt(total(stageGains(exhaust(e.isp), n, 0.1, 0.02)), 1)} km/s</td>)}</tr>)}</tbody>
  </table>
  <div class="controls needs-js">
    {ENGINES.map((e, i) => <button class="pick" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-stages-pick={i}>{e.name}</button>)}
  </div>
  <div class="controls needs-js">
    <label class="field"><span>Stages <output data-stages-outn>2</output></span><input class="range" type="range" min="1" max="4" step="1" value="2" data-stages-n aria-label="Number of stages" /></label>
    <label class="field"><span>Structure <output data-stages-outs>10</output>% of each stage</span><input class="range" type="range" min="3" max="25" step="1" value="10" data-stages-s aria-label="Share of each stage that is structure, in per cent" /></label>
  </div>
  <p class="status" aria-live="polite" data-stages-status>Two stages with 10% structure each, burning kerosene and oxygen, gain {fmt(total(stageGains(ve, 2, 0.1, 0.02)), 1)} km/s in all. The speed needed is {NEED}.</p>
</div>
