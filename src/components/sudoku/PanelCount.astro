---
// Puzzle 4: how many solutions, on a 4 by 4 grid.
import Grid from './Grid.astro';
import { GRIDS_4, parse, SMALL, SOLVED4 } from '../../lib/sudoku';
---

<div class="tool" data-count-tool>
  <Grid grid={parse(SOLVED4)} shape={SMALL} label="A finished 4 by 4 grid. Click a digit to take it away." id="count" />
  <table class="times">
    <caption class="sr-only">How many grids there are</caption>
    <thead><tr><th scope="col">Size</th><th scope="col">Different finished grids</th></tr></thead>
    <tbody>
      <tr><th scope="row">4 by 4</th><td>{GRIDS_4}</td></tr>
      <tr><th scope="row">9 by 9</th><td>6,670,903,752,021,072,936,960</td></tr>
    </tbody>
  </table>
  <div class="controls needs-js">
    <button class="btn" type="button" data-count-reset>Put the digits back</button>
    <button class="btn" type="button" data-count-least>Take away all I can</button>
    <button class="btn" type="button" data-count-all>Count all 4 by 4 grids</button>
  </div>
  <p class="status" aria-live="polite" data-count-status>All sixteen digits are given, so there is one way to finish the grid. Click a digit to take it away.</p>
</div>
