---
// Puzzle 2: what can go here, on a 9 by 9 grid.
import Grid from './Grid.astro';
import { BIG, parse, PUZZLE9 } from '../../lib/sudoku';
---

<div class="tool" data-cands-tool>
  <Grid grid={parse(PUZZLE9)} shape={BIG} label="A 9 by 9 sudoku with 34 digits given" id="cands" />
  <div class="controls needs-js">
    <button class="pick" type="button" aria-pressed="false" data-cands-marks>Pencil marks</button>
    <button class="btn" type="button" data-cands-find>Find a single</button>
    <button class="btn" type="button" data-cands-place>Place it</button>
    <button class="btn" type="button" data-cands-reset>Start again</button>
  </div>
  <p class="status" aria-live="polite" data-cands-status>Click a cell to see which digits can go in it.</p>
</div>
