---
// Map 3: the clock against the Sun.
import { cities, clockAheadMin } from '../../lib/zones';
const max = 120;
---

<div class="tool" data-drift-tool>
  <div class="controls needs-js">
    <button type="button" class="pick" aria-pressed="false" data-drift-summer>Summer time in Europe and the US</button>
  </div>
  <ul class="gauges" data-drift-bars>
    {cities.map((c) => {
      const m = clockAheadMin(c);
      return <li><span class="nm">{c.name}</span><span class="track"><span class={m >= 0 ? 'fill ahead' : 'fill behind'} style={`width:${Math.max(1, (Math.abs(m) / max) * 100)}%`}></span></span><span class="val">{m >= 0 ? '+' : '-'}{Math.abs(m)} min</span></li>;
    })}
  </ul>
  <p class="status" aria-live="polite" data-drift-status>
    Winter time. A plus means the clock is ahead of the Sun, a minus that it is behind. Amsterdam is {clockAheadMin(cities[0])} minutes ahead.
  </p>
</div>
