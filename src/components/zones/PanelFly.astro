---
// Map 4: fly across zones.
import { arrive, dayWord, fmtClock, trips } from '../../lib/zones';
const t = trips[1];
const r = arrive(t, 18, 8, false);
---

<div class="tool" data-fly-tool>
  <div class="controls needs-js" role="group" aria-label="Pick a trip">
    {trips.map((x, i) => <button type="button" class="pick" aria-pressed={i === 1 ? 'true' : 'false'} data-fly-pick={x.id}>{x.label}</button>)}
  </div>
  <div class="controls needs-js">
    <label class="field"><span>Leave at <output data-fly-leave-out>18:00</output></span><input class="range" type="range" min="0" max="23.75" step="0.25" value="18" data-fly-leave aria-label="Time you leave, on the clock where you start" /></label>
  </div>
  <div class="controls needs-js">
    <label class="field"><span>Flight <output data-fly-hours-out>8 hours</output></span><input class="range" type="range" min="1" max="16" step="0.5" value="8" data-fly-hours aria-label="Length of the flight in hours" /></label>
  </div>
  <p class="status" aria-live="polite" data-fly-status>
    {t.label}: you leave at 18:00 and fly 8 hours. The clock at the other end reads {r.clock}, {dayWord(r.shift)}. The two clocks differ by {Math.abs(r.diff)} hours.
  </p>
</div>
