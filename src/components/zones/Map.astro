---
// The whole page: a flat map of the world with four things to try. They are the Panel components and src/scripts/zones.
// Without a script each part shows one picture or table.
import '../../styles/zones.css';
import { intro, panels } from '../../data/zones';
import PanelSun from './PanelSun.astro';
import PanelClocks from './PanelClocks.astro';
import PanelDrift from './PanelDrift.astro';
import PanelFly from './PanelFly.astro';

const tools: Record<string, typeof PanelSun> = { sun: PanelSun, clocks: PanelClocks, drift: PanelDrift, fly: PanelFly };
---

<div class="zones" data-zones>
  <section class="panel opening" aria-labelledby="zones-intro">
    <div class="panel-inner">
      <div class="words">
        <p class="kicker">Round the world</p>
        <h2 id="zones-intro">{intro.title}</h2>
        {intro.paras.map((p) => <p class="para">{p}</p>)}
      </div>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="panel" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="panel-inner">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/zones/zones';
</script>
