---
// Map 2: the clocks of eight cities at one moment.
import { cities, dayShift, dayWord, fmtClock, fmtOffset } from '../../lib/zones';
const h = 12;
const ams = cities[0];
---

<div class="tool" data-clocks-tool>
  <div class="controls needs-js">
    <label class="field"><span>Time in Amsterdam <output data-clocks-out>{fmtClock(h)}</output></span><input class="range" type="range" min="0" max="24" step="0.25" value={h} data-clocks-range aria-label="Time in Amsterdam in hours" /></label>
  </div>
  <table class="times">
    <thead><tr><th scope="col">City</th><th scope="col">Offset</th><th scope="col">Clock</th></tr></thead>
    <tbody data-clocks-body>
      {cities.map((c) => {
        const t = h - ams.off + c.off;
        return <tr><th scope="row">{c.name}</th><td>{fmtOffset(c.off)}</td><td>{fmtClock(t)}{dayShift(t) !== 0 ? `, ${dayWord(dayShift(t))}` : ''}</td></tr>;
      })}
    </tbody>
  </table>
  <p class="status" aria-live="polite" data-clocks-status>When it is {fmtClock(h)} in Amsterdam, it is {fmtClock(h - ams.off + cities[4].off)} in Tokyo and {fmtClock(h - ams.off + cities[2].off)} in New York, in winter time.</p>
</div>
