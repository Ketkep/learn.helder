---
// Back face, upper dial: nineteen years. Without a script the text shows 19 years.
import { ageAfterYears, fmt, metonicDays, metonicGapHours } from '../../lib/antikythera';
---

<div class="tool" data-metonic-tool>
  <table class="times">
    <caption class="sr-only">Nineteen years and 235 months compared</caption>
    <thead><tr><th scope="col">Span</th><th scope="col">Days</th></tr></thead>
    <tbody>
      <tr><th scope="row">19 years</th><td>{fmt(19 * 365.2422, 2)}</td></tr>
      <tr><th scope="row">235 months</th><td>{fmt(metonicDays, 2)}</td></tr>
    </tbody>
  </table>
  <div class="controls needs-js">
    <label class="field"><span>Years <output data-metonic-out>19</output></span><input class="range" type="range" min="1" max="19" step="1" value="19" data-metonic-range aria-label="Years since a new moon on a given date" /></label>
  </div>
  <p class="status" aria-live="polite" data-metonic-status>After 19 years the Moon is {fmt(ageAfterYears(19), 1)} days old on the same date, so it is about {fmt(metonicGapHours(), 0)} hours short of new again.</p>
</div>
