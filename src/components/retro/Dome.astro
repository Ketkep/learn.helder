---
// The whole page: three seats under a dome, shown as tabs when there is a script and one after the other when there is not.
// They are the Panel components and src/scripts/retro.
import '../../styles/retro.css';
import { intro, seats } from '../../data/retro';
import PanelOrbit from './PanelOrbit.astro';
import PanelGraph from './PanelGraph.astro';
import PanelStories from './PanelStories.astro';

const tools: Record<string, typeof PanelOrbit> = { orbit: PanelOrbit, graph: PanelGraph, stories: PanelStories };
---

<div class="retro" data-retro>
  <section class="opening" aria-labelledby="retro-intro">
    <div class="wrap">
      <p class="kicker">Under the dome</p>
      <h2 id="retro-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  <div class="seats">
    <div class="tabs needs-js" role="tablist" aria-label="Seats under the dome" data-tabs>
      {seats.map((p, i) => <button class="tab" type="button" role="tab" id={`tab-${p.id}`} aria-controls={`seat-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={p.id}>{p.kicker.replace(' seat', '')}: {p.title}</button>)}
    </div>
    {
      seats.map((p) => {
        const Tool = tools[p.id];
        return (
          <section class="seat" id={`seat-${p.id}`} aria-labelledby={`seat-${p.id}-h`} data-seat={p.id}>
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`seat-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import '../../scripts/retro/retro';
</script>
