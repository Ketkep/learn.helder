---
// Alcove 3: the right clock for the age. Without a script the table gives the range each clock can read.
import { CLOCKS, oldest, years, youngest } from '../../lib/halflife';
---

<div class="tool" data-right-tool>
  <table class="times">
    <caption class="sr-only">The range of ages each clock can read, by the rule of thumb of this page</caption>
    <thead><tr><th scope="col">Clock</th><th scope="col">Youngest it can read</th><th scope="col">Oldest it can read</th><th scope="col">Used on</th></tr></thead>
    <tbody>{CLOCKS.map((c) => <tr><th scope="row">{c.name}</th><td>{years(youngest(c.half))}</td><td>{years(oldest(c.half))}</td><td>{c.what}</td></tr>)}</tbody>
  </table>
  <div class="verdicts needs-js" data-right-cards></div>
  <div class="controls needs-js">
    <label class="field"><span>Age of the sample <output data-right-out>707 thousand years</output></span><input class="range" type="range" min="0" max="100" step="1" value="50" data-right-range aria-label="Age of the sample on a scale from 100 years to 5 billion years" /></label>
  </div>
  <p class="status" aria-live="polite" data-right-status>Slide the age to see which clock can read it.</p>
</div>
