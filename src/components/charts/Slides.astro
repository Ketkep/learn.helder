---
// The whole page: a slide show with three slides. They are the Panel components and src/scripts/charts.
// Without a script each slide shows one picture or table.
import '../../styles/charts.css';
import { intro, panels } from '../../data/charts';
import PanelBaseline from './PanelBaseline.astro';
import PanelWindow from './PanelWindow.astro';
import PanelArea from './PanelArea.astro';

const tools: Record<string, typeof PanelBaseline> = { baseline: PanelBaseline, window: PanelWindow, area: PanelArea };
---

<div class="charts" data-charts>
  <section class="opening" aria-labelledby="charts-intro">
    <div class="wrap">
      <p class="kicker">Title slide</p>
      <h2 id="charts-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  <div class="deck">
    {
      panels.map((p, i) => {
        const Tool = tools[p.id];
        return (
          <section class="slide" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
            <p class="number" aria-hidden="true">Slide {i + 1} of {panels.length}</p>
            <p class="kicker">{p.kicker}</p>
            <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
            <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
            <Tool />
            {
              p.tags && (
                <div class="tags">
                  {p.tags.map((t) => (
                    <aside class="tag">
                      <p class="tag-label">{t.label}</p>
                      <p class="tag-text">{t.text}</p>
                    </aside>
                  ))}
                </div>
              )
            }
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import '../../scripts/charts/charts';
</script>
