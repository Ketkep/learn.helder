---
// One topic as a book cover in the series, standing on a shelf.
// The whole card is one link (cover and caption). Its name is the title and its
// description is the hook, so screen readers do not read every piece of text.
import { getTopicView, type Topic } from '../data/topics';
import { coverVars as makeCoverVars } from '../lib/color';
import CoverArt from './CoverArt.astro';

interface Props {
  topic: Topic;
  /** Display number, for example "01". */
  number: string;
}

const { topic, number } = Astro.props;
const isDraft = topic.status === 'draft';
// A topic can lead to a translated page. The card then shows that page's words and a small language mark.
const view = getTopicView(topic);
const other = view.lang !== 'en';
const coverVars = makeCoverVars(topic.accent);
const titleId = `title-${topic.slug}`;
const hookId = `hook-${topic.slug}`;
---

<article class="card" data-card data-category={topic.category} style={coverVars}>
  <a class="link" data-play href={view.href} hreflang={other ? view.lang : undefined} aria-labelledby={titleId} aria-describedby={hookId}>
    <div class="shelf">
      <div class="cover">
        <div class="meta">
          <span class="num">{number}</span>
          <span class="tags">
            {isDraft && <span class="draft">Draft</span>}
            {other && <span class="lang" aria-hidden="true">{view.lang.toUpperCase()}</span>}
            <span>{topic.category}</span>
          </span>
        </div>

        <h3 class="title" id={titleId} lang={other ? view.lang : undefined}>{view.title}</h3>

        <div class="art-slot">
          <CoverArt name={topic.preview} />
        </div>
      </div>
    </div>

    <div class="caption">
      <p class="hook" id={hookId} lang={other ? view.lang : undefined}>{view.hook}</p>
      <svg class="arrow" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 12h15M13 6l6 6-6 6" />
      </svg>
    </div>
  </a>
</article>

<style>
  .link {
    /* 0 at rest, 1 on hover or focus: drives the movement inside the drawing */
    --mv: 0;

    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  /* The plank the cover stands on. It reaches half a gap to each side,
     so the planks of neighbouring covers join into one shelf. */
  .shelf {
    position: relative;
    padding-bottom: 12px;
  }

  .shelf::after {
    content: '';
    position: absolute;
    right: calc(var(--gap, 2rem) / -2 - 1px);
    bottom: 0;
    left: calc(var(--gap, 2rem) / -2 - 1px);
    height: 12px;
    background: var(--shelf);
    border-radius: 3px;
  }

  .cover {
    display: flex;
    flex-direction: column;
    aspect-ratio: 5 / 6;
    overflow: hidden;
    padding: 1.1rem 1.3rem 0 1.75rem;
    background: var(--grain), var(--cover);
    color: var(--on-cover);
    /* A book: square spine on the left, softer corners on the right */
    border-radius: 3px 9px 9px 3px;
    /* The spine: a darker strip with a light edge, plus a thin shadow underneath */
    box-shadow:
      inset 11px 0 0 rgb(0 0 0 / 0.16),
      inset 12px 0 0 rgb(255 255 255 / 0.16),
      0 1px 2px rgb(0 0 0 / 0.18);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.4s;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  .tags {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  /* "Draft" only shows in `npm run dev`, drafts are never built for production.
     The language mark shows when the card leads to a translated page. */
  .draft,
  .lang {
    padding: 0 0.5rem;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    font-size: 0.78rem;
  }

  .title {
    margin-top: 1rem;
    font-size: clamp(2rem, 1.3rem + 1.9vw, 2.6rem);
    line-height: 1;
  }

  /* The drawing sits at the bottom of the cover and bleeds off the right and bottom edges */
  .art-slot {
    margin: auto -1.3rem 0 calc(-1.75rem + 12px);
  }

  .caption {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .hook {
    max-width: 30ch;
    color: var(--ink);
    transition: color 0.2s;
  }

  .arrow {
    flex: none;
    margin-top: 0.1rem;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Keyboard focus: an outline around the cover, and the same state as hover */
  .link:focus-visible {
    outline: none;
  }

  .link:focus-visible .cover {
    outline: 3px solid var(--ink);
    outline-offset: 5px;
  }

  .link:focus-visible .cover,
  .link:hover .cover {
    box-shadow:
      inset 11px 0 0 rgb(0 0 0 / 0.16),
      inset 12px 0 0 rgb(255 255 255 / 0.16),
      0 22px 28px -12px rgb(0 0 0 / 0.5);
  }

  /* Movement is only for people who have not asked for less of it */
  @media (prefers-reduced-motion: no-preference) {
    .link:focus-visible {
      --mv: 1;
    }

    .link:focus-visible .cover {
      transform: translateY(-8px) rotate(-0.6deg);
    }

    .link:focus-visible .arrow {
      transform: translateX(5px);
    }

    @media (hover: hover) {
      .link:hover {
        --mv: 1;
      }

      .link:hover .cover {
        transform: translateY(-8px) rotate(-0.6deg);
      }

      .link:hover .arrow {
        transform: translateX(5px);
      }
    }
  }
</style>
