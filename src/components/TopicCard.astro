---
// One topic as a book cover in the series. The whole card is clickable: the link
// sits on the title and a pseudo-element stretches it over the card, so screen
// readers read just the title instead of the whole card.
import type { Topic } from '../data/topics';
import { readableInk } from '../lib/color';
import CoverArt from './CoverArt.astro';

interface Props {
  topic: Topic;
  /** Display number, for example "01". */
  number: string;
}

const { topic, number } = Astro.props;
const isDraft = topic.status === 'draft';
const coverVars = `--cover: ${topic.accent}; --on-cover: ${readableInk(topic.accent)};`;
---

<article class="card" data-card data-category={topic.category} style={coverVars}>
  <div class="cover">
    <div class="meta">
      <span class="num">{number}</span>
      <span class="tags">
        {isDraft && <span class="draft">Draft</span>}
        <span>{topic.category}</span>
      </span>
    </div>

    <h3 class="title">
      <a class="link" href={`/${topic.slug}/`}>{topic.title}</a>
    </h3>

    <div class="art-slot">
      <CoverArt name={topic.preview} />
    </div>
  </div>

  <div class="caption">
    <p class="hook">{topic.hook}</p>
    <svg class="arrow" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 12h15M13 6l6 6-6 6" />
    </svg>
  </div>
</article>

<style>
  .card {
    /* 0 at rest, 1 on hover: drives the movement inside the drawing */
    --mv: 0;

    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .cover {
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 5 / 6;
    overflow: hidden;
    padding: 1.1rem 1.3rem 1.3rem 1.75rem;
    background: var(--grain), var(--cover);
    color: var(--on-cover);
    /* A book: square spine on the left, softer corners on the right */
    border-radius: 3px 9px 9px 3px;
    /* The spine: a darker strip with a light edge, plus a thin shadow underneath */
    box-shadow:
      inset 11px 0 0 rgb(0 0 0 / 0.16),
      inset 12px 0 0 rgb(255 255 255 / 0.16),
      0 1px 2px rgb(0 0 0 / 0.18);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.4s;
  }

  .meta {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  .tags {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  /* Only shown in `npm run dev`, drafts are never built for production */
  .draft {
    padding: 0 0.5rem;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    font-size: 0.78rem;
  }

  .title {
    position: relative;
    z-index: 1;
    margin-top: 1rem;
    font-size: clamp(2rem, 1.3rem + 1.9vw, 2.6rem);
    line-height: 1;
  }

  .link {
    color: inherit;
    text-decoration: none;
  }

  /* Stretches the link over the whole card (cover and caption) */
  .link::after {
    content: '';
    position: absolute;
    inset: -0.5rem -0.5rem -4.5rem -0.5rem;
    z-index: 2;
  }

  .link:focus-visible {
    outline: none;
  }

  .art-slot {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 12px; /* clear of the spine */
  }

  .caption {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .hook {
    max-width: 30ch;
    color: var(--ink-soft);
    transition: color 0.2s;
  }

  .arrow {
    flex: none;
    margin-top: 0.1rem;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Keyboard focus: an outline around the cover and the same state as hover */
  .card:has(.link:focus-visible) .cover {
    outline: 3px solid var(--ink);
    outline-offset: 5px;
    box-shadow:
      inset 11px 0 0 rgb(0 0 0 / 0.16),
      inset 12px 0 0 rgb(255 255 255 / 0.16),
      0 22px 32px -14px rgb(0 0 0 / 0.45);
  }

  .card:has(.link:focus-visible) .hook {
    color: var(--ink);
  }

  @media (hover: hover) {
    .card:hover .cover {
      box-shadow:
        inset 11px 0 0 rgb(0 0 0 / 0.16),
        inset 12px 0 0 rgb(255 255 255 / 0.16),
        0 22px 32px -14px rgb(0 0 0 / 0.45);
    }

    .card:hover .hook {
      color: var(--ink);
    }
  }

  /* Movement is only for people who have not asked for less of it */
  @media (prefers-reduced-motion: no-preference) {
    .card:has(.link:focus-visible) {
      --mv: 1;
    }

    .card:has(.link:focus-visible) .cover {
      transform: translateY(-6px) rotate(-0.6deg);
    }

    .card:has(.link:focus-visible) .arrow {
      transform: translateX(5px);
    }

    @media (hover: hover) {
      .card:hover {
        --mv: 1;
      }

      .card:hover .cover {
        transform: translateY(-6px) rotate(-0.6deg);
      }

      .card:hover .arrow {
        transform: translateX(5px);
      }
    }
  }
</style>
