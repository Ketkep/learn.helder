---
// The whole page: a party with three rooms, one thing to try in each. They are the Panel components and src/scripts/birthday.
// Without a script each room shows one table or picture.
import '../../styles/birthday.css';
import { intro, rooms } from '../../data/birthday';
import PanelParty from './PanelParty.astro';
import PanelOdds from './PanelOdds.astro';
import PanelYou from './PanelYou.astro';

const tools: Record<string, typeof PanelParty> = { party: PanelParty, odds: PanelOdds, you: PanelYou };
---

<div class="birthday" data-birthday>
  <section class="opening" aria-labelledby="birthday-intro">
    <div class="wrap">
      <p class="kicker">The party</p>
      <h2 id="birthday-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  <div class="rooms">
    {
      rooms.map((p) => {
        const Tool = tools[p.id];
        return (
          <section class="room" id={`room-${p.id}`} aria-labelledby={`room-${p.id}-h`}>
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`room-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="floor">
              <Tool />
            </div>
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import '../../scripts/birthday/birthday';
</script>
