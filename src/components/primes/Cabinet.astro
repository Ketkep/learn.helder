---
// The whole page: a cabinet of five drawers. Each drawer front is a heading. With a script the front becomes
// a button that pulls the drawer open (see src/scripts/primes/cabinet.ts). Without a script every drawer is open
// and the page is plain sections, one after another.
import '../../styles/primes.css';
import { intro, drawers } from '../../data/primes';
import ToolSieve from './ToolSieve.astro';
import ToolRects from './ToolRects.astro';
import ToolEuclid from './ToolEuclid.astro';
import ToolDensity from './ToolDensity.astro';
import ToolLock from './ToolLock.astro';

const tools: Record<string, typeof ToolSieve> = {
  sieve: ToolSieve,
  rect: ToolRects,
  euclid: ToolEuclid,
  density: ToolDensity,
  lock: ToolLock,
};
---

<div class="cab" data-cab>
  <div class="cab-top">
    <div class="cab-top-inner">
      <div class="cab-intro">
        <h2>{intro.title}</h2>
        {intro.paras.map((p) => <p>{p}</p>)}
      </div>
      <div class="cab-tools needs-js">
        <button class="btn" type="button" data-open-all>Open all drawers</button>
        <button class="btn" type="button" data-close-all>Close all</button>
        <button class="snd" type="button" data-sound aria-pressed="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
            <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span class="visually-hidden" data-sound-label>Sound on</span>
        </button>
      </div>
    </div>
  </div>

  <div class="cab-body">
    {
      drawers.map((d, i) => {
        const Tool = tools[d.id];
        const next = drawers[i + 1];
        return (
          <section class="drawer" id={`drawer-${d.id}`} data-drawer={d.id}>
            <h2 class="front" id={`drawer-${d.id}-h`}>
              <span class="front-row">
                <span class="front-no" aria-hidden="true">{i + 1}</span>
                <span class="front-text">
                  <span class="front-title">{d.title}</span>
                  <span class="front-teaser">{d.teaser}</span>
                </span>
                <span class="front-knob needs-js" aria-hidden="true"></span>
              </span>
            </h2>
            <div class="panel" id={`drawer-${d.id}-panel`}>
              <div class="tray">
                <div class="copy">
                  <p class="kicker">{d.kicker}</p>
                  {d.paras.map((p) => <p class="para">{p}</p>)}
                  {
                    d.tags?.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))
                  }
                </div>
                <div class="tool">
                  <Tool />
                  {
                    next && (
                      <button class="btn next-btn needs-js" type="button" data-next={next.id}>
                        Next drawer: {next.title}
                      </button>
                    )
                  }
                </div>
              </div>
            </div>
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import '../../scripts/primes/cabinet';
</script>
