---
// The whole page: a book with three spreads, one thing to try in each. They are the Panel components and src/scripts/braille.
// Without a script each spread shows one table or picture.
import '../../styles/braille.css';
import { intro, spreads } from '../../data/braille';
import PanelCell from './PanelCell.astro';
import PanelRows from './PanelRows.astro';
import PanelWrite from './PanelWrite.astro';

const tools: Record<string, typeof PanelCell> = { cell: PanelCell, rows: PanelRows, write: PanelWrite };
---

<div class="braille" data-braille>
  <section class="opening" aria-labelledby="braille-intro">
    <div class="wrap">
      <p class="kicker">The book</p>
      <h2 id="braille-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  <div class="spreads">
    {
      spreads.map((p) => {
        const Tool = tools[p.id];
        return (
          <section class="spread" id={`spread-${p.id}`} aria-labelledby={`spread-${p.id}-h`}>
            <div class="words page">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`spread-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="floor page">
              <Tool />
            </div>
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import '../../scripts/braille/braille';
</script>
