---
// Tray 2: a mountain floats. Without a script the table gives a few heights and roots.
import { floatSvg, fmt, rootOf } from '../../lib/mountains';
const rows = [1, 3, 5, 8.8];
---

<div class="tool" data-float-tool>
  <svg class="plate" viewBox="0 0 300 210" role="img" aria-label="A block of crust floating on the mantle, with a mountain on top and a deeper root below." data-float-svg>
    <rect class="stage" x="1" y="1" width="298" height="208" rx="8"></rect>
    <g set:html={floatSvg(5)} data-float-g></g>
  </svg>
  <table class="times">
    <caption class="sr-only">The root under a mountain of each height, in the simplest model</caption>
    <thead><tr><th scope="col">Height</th><th scope="col">Root</th></tr></thead>
    <tbody>{rows.map((h) => <tr><th scope="row">{fmt(h, 1)} km</th><td>{fmt(rootOf(h), 1)} km</td></tr>)}</tbody>
  </table>
  <div class="controls needs-js">
    <label class="field"><span>Height <output data-float-out>5.0</output> km</span><input class="range" type="range" min="0" max="88" step="1" value="50" data-float-range aria-label="Height of the mountain in kilometres, times ten" /></label>
  </div>
  <p class="status" aria-live="polite" data-float-status>A mountain 5.0 km high has a root {fmt(rootOf(5), 1)} km deep in this model, so the crust under it is {fmt(35 + rootOf(5) + 5, 1)} km thick.</p>
</div>
