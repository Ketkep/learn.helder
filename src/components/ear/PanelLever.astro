---
// First floor: the lever of the middle ear. Without a script the numbers show an area ratio of 14 and a lever of 1.3.
import { decibels, fmt, leverSvg, pressureGain } from '../../lib/ear';
const gain = pressureGain(14, 1.3);
---

<div class="tool" data-lever-tool>
  <svg class="plan" viewBox="0 0 300 140" role="img" aria-label="Two discs joined by a bar: a large one for the eardrum and a small one for the oval window." data-lever-svg>
    <rect class="stage" x="1" y="1" width="298" height="138" rx="6"></rect>
    <g set:html={leverSvg(14)} data-lever-g></g>
  </svg>
  <div class="controls needs-js">
    <label class="field"><span>Area ratio <output data-lever-area>14</output></span><input class="range" type="range" min="10" max="35" step="1" value="14" data-lever-area-range aria-label="How many times larger the eardrum is than the oval window" /></label>
    <label class="field"><span>Lever <output data-lever-lever>1.3</output></span><input class="range" type="range" min="10" max="20" step="1" value="13" data-lever-lever-range aria-label="Lever of the bones, times ten" /></label>
  </div>
  <p class="status" aria-live="polite" data-lever-status>An area ratio of 14 and a lever of 1.3 raise the pressure {fmt(gain, 1)} times. That is {fmt(decibels(gain), 0)} decibels.</p>
</div>
