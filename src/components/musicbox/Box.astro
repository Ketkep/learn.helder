---
// The whole page: a music box opened up, with three compartments. They are the Panel components and src/scripts/musicbox.
// Without a script each compartment shows one picture or table.
import '../../styles/musicbox.css';
import { intro, panels } from '../../data/musicbox';
import PanelTeeth from './PanelTeeth.astro';
import PanelPins from './PanelPins.astro';
import PanelTuning from './PanelTuning.astro';

const tools: Record<string, typeof PanelTeeth> = { teeth: PanelTeeth, pins: PanelPins, tuning: PanelTuning };
---

<div class="musicbox" data-musicbox>
  <section class="opening" aria-labelledby="musicbox-intro">
    <div class="wrap">
      <p class="kicker">The lid</p>
      <h2 id="musicbox-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  <div class="bays">
    {
      panels.map((p) => {
        const Tool = tools[p.id];
        return (
          <section class="bay" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
            <p class="kicker">{p.kicker}</p>
            <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
            <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
            <Tool />
            {
              p.tags && (
                <div class="tags">
                  {p.tags.map((t) => (
                    <aside class="tag">
                      <p class="tag-label">{t.label}</p>
                      <p class="tag-text">{t.text}</p>
                    </aside>
                  ))}
                </div>
              )
            }
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import '../../scripts/musicbox/musicbox';
</script>
