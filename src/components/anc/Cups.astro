---
// The whole page: a pair of headphones in three parts, one thing to try in each. They are the Panel components and src/scripts/anc.
// Without a script each part shows one picture or table.
import '../../styles/anc.css';
import { intro, parts } from '../../data/anc';
import PanelCancel from './PanelCancel.astro';
import PanelDelay from './PanelDelay.astro';
import PanelExact from './PanelExact.astro';

const tools: Record<string, typeof PanelCancel> = { cancel: PanelCancel, delay: PanelDelay, exact: PanelExact };
---

<div class="anc" data-anc>
  <section class="opening" aria-labelledby="anc-intro">
    <div class="wrap">
      <p class="kicker">The headphones</p>
      <h2 id="anc-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  <div class="parts">
    {
      parts.map((p) => {
        const Tool = tools[p.id];
        return (
          <section class="part" id={`part-${p.id}`} aria-labelledby={`part-${p.id}-h`}>
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`part-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import '../../scripts/anc/anc';
</script>
