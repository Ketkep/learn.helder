---
// The whole page: a museum cabinet with four drawers. They are the Panel components and src/scripts/alpha.
// Every drawer is open without a script. Each one is a details element, so it can also be closed by hand.
import '../../styles/alpha.css';
import { intro, panels } from '../../data/alpha';
import PanelOx from './PanelOx.astro';
import PanelNames from './PanelNames.astro';
import PanelCount from './PanelCount.astro';
import PanelChain from './PanelChain.astro';

const tools: Record<string, typeof PanelOx> = { ox: PanelOx, names: PanelNames, count: PanelCount, chain: PanelChain };
---

<div class="alpha" data-alpha>
  <section class="opening" aria-labelledby="alpha-intro">
    <div class="wrap">
      <p class="kicker">Museum cabinet</p>
      <h2 id="alpha-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  <div class="cabinet">
    {
      panels.map((p) => {
        const Tool = tools[p.id];
        return (
          <details class="drawer" id={`panel-${p.id}`} open>
            <summary><span class="label">{p.label}</span><span class="name">{p.title}</span><span class="handle" aria-hidden="true"></span></summary>
            <div class="drawer-body">
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              <Tool />
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
          </details>
        );
      })
    }
  </div>
</div>

<script>
  import '../../scripts/alpha/alpha';
</script>
