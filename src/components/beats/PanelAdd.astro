---
// Movement 1: where the swells come from. Without a script the picture shows 220 and 222 hertz and the table lists four pairs.
import { addSvg, beatRate, every, fmt, heard } from '../../lib/beats';
---

<div class="tool" data-add-tool>
  <svg class="plate" viewBox="0 0 300 220" role="img" aria-label="Two waves of nearly the same pitch, and below them their sum, which swells and fades twice." data-add-svg>
    <g set:html={addSvg(2)} data-add-g></g>
  </svg>
  <table class="times">
    <caption class="sr-only">The swells for four pairs of notes</caption>
    <thead><tr><th scope="col">Notes</th><th scope="col">Swells</th><th scope="col">Pitch you hear</th></tr></thead>
    <tbody>{[[220, 221], [220, 222], [220, 224], [440, 444]].map(([a, b]) => <tr><th scope="row">{a} and {b} Hz</th><td>{fmt(beatRate(a, b))} a second</td><td>{fmt(heard(a, b), 1)} Hz</td></tr>)}</tbody>
  </table>
  <div class="controls needs-js">
    <label class="field"><span>Second note <output data-add-out>222</output> Hz</span><input class="range" type="range" min="220" max="232" step="1" value="222" data-add-range aria-label="Frequency of the second note in hertz" /></label>
    <button class="btn fill" type="button" data-add-listen>Listen</button>
  </div>
  <p class="status" aria-live="polite" data-add-status>220 and 222 hertz: {every(2)}. You hear a note of {fmt(heard(220, 222))} hertz.</p>
</div>
