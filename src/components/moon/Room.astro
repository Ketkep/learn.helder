---
// The whole page: a dark room with four stations. The stations are the Panel components and src/scripts/moon.
// Without a script each station shows one picture or table.
import '../../styles/moon.css';
import { intro, panels } from '../../data/moon';
import PanelLook from './PanelLook.astro';
import PanelRise from './PanelRise.astro';
import PanelMonth from './PanelMonth.astro';
import PanelEclipse from './PanelEclipse.astro';

const tools: Record<string, typeof PanelLook> = { look: PanelLook, rise: PanelRise, month: PanelMonth, eclipse: PanelEclipse };
---

<div class="moon" data-moon>
  <section class="panel opening" aria-labelledby="moon-intro">
    <div class="panel-inner">
      <div class="words">
        <p class="kicker">Lights off</p>
        <h2 id="moon-intro">{intro.title}</h2>
        {intro.paras.map((p) => <p class="para">{p}</p>)}
      </div>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="panel" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="panel-inner">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/moon/moon';
</script>
