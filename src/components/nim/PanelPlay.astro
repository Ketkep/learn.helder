---
// Try 1: play the machine, normal play.
import Sticks from './Sticks.astro';
---

<div class="tool" data-play-tool="normal">
  <Sticks id="play" />
  <div class="controls needs-js" role="group" aria-label="Who starts">
    <button type="button" class="pick" aria-pressed="true" data-opt="first-you">You start</button>
    <button type="button" class="pick" aria-pressed="false" data-opt="first-machine">Machine starts</button>
  </div>
  <div class="controls needs-js" role="group" aria-label="How the machine plays">
    <button type="button" class="pick" aria-pressed="true" data-opt="skill-random">Machine plays at random</button>
    <button type="button" class="pick" aria-pressed="false" data-opt="skill-perfect">Machine plays perfectly</button>
  </div>
  <div class="controls needs-js"><button type="button" class="btn fill" data-new>New game</button></div>
  <p class="status" aria-live="polite" data-status>Heaps of 1, 3, 5 and 7 sticks. Take the last stick to win. Click a stick to take it and the sticks to its right.</p>
</div>
