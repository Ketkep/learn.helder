---
// The whole page: a table with matchsticks and four things to try. They are the Panel components and src/scripts/nim.
// Without a script each part shows one picture or table.
import '../../styles/nim.css';
import { intro, panels } from '../../data/nim';
import PanelPlay from './PanelPlay.astro';
import PanelBinary from './PanelBinary.astro';
import PanelHunt from './PanelHunt.astro';
import PanelMisere from './PanelMisere.astro';

const tools: Record<string, typeof PanelPlay> = { play: PanelPlay, binary: PanelBinary, hunt: PanelHunt, misere: PanelMisere };
---

<div class="nim" data-nim>
  <section class="panel opening" aria-labelledby="nim-intro">
    <div class="panel-inner">
      <div class="words">
        <p class="kicker">Sticks on the table</p>
        <h2 id="nim-intro">{intro.title}</h2>
        {intro.paras.map((p) => <p class="para">{p}</p>)}
        <button class="snd needs-js" type="button" data-sound aria-pressed="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
            <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span data-sound-label>Sound on</span>
        </button>
      </div>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="panel" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="panel-inner">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/nim/nim';
</script>
