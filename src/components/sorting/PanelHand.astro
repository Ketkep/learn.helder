---
// Tray 1: sort a row by hand. Without a script the picture shows the first shuffle and says how few swaps it needs.
import { barsSvg, inversions, shuffled } from '../../lib/sorting';
const row = shuffled(8, 1);
---

<div class="tool" data-hand-tool>
  <div data-hand-host>
    <svg class="plate" viewBox="0 0 300 170" role="img" aria-label="Eight bars of different heights in a jumbled order." data-hand-svg>
      <g set:html={barsSvg(row)}></g>
    </svg>
  </div>
  <div class="controls needs-js">
    <button class="btn" type="button" data-hand-new>New shuffle</button>
  </div>
  <p class="status" aria-live="polite" data-hand-status>This row has {inversions(row)} wrong pairs, so at least {inversions(row)} swaps of neighbours are needed.</p>
</div>
