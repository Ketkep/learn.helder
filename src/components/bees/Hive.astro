---
// The whole page: four looks into the hive. The panels are the Panel components and src/scripts/bees.
// Without a script each panel shows one dance and its map.
import '../../styles/bees.css';
import { intro, panels } from '../../data/bees';
import PanelRead from './PanelRead.astro';
import PanelSend from './PanelSend.astro';
import PanelSun from './PanelSun.astro';
import PanelNoise from './PanelNoise.astro';

const tools: Record<string, typeof PanelRead> = { read: PanelRead, send: PanelSend, sun: PanelSun, noise: PanelNoise };
---

<div class="bees" data-bees>
  <section class="panel opening" aria-labelledby="bees-intro">
    <div class="panel-inner">
      <div class="words">
        <p class="kicker">Inside the hive</p>
        <h2 id="bees-intro">{intro.title}</h2>
        {intro.paras.map((p) => <p class="para">{p}</p>)}
      </div>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="panel" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="panel-inner">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/bees/bees';
</script>
