---
// Look 1: read a dance. The angle and the length of the run give a place on the map.
import Pair from './Pair.astro';
import { compass, flowerBearing, fmtAngle } from '../../lib/bees';
const [angle, seconds, sun] = [60, 2, 180];
const bearing = flowerBearing(angle, sun);
---

<div class="tool" data-read-tool>
  <Pair angle={angle} seconds={seconds} sun={sun} bearing={bearing} km={seconds} />
  <div class="controls needs-js">
    <label class="field"><span>The sun is in the</span>
      <select class="select" data-read-sun aria-label="Where the sun is">
        <option value="90">east (morning)</option>
        <option value="180" selected>south (midday)</option>
        <option value="270">west (evening)</option>
      </select>
    </label>
  </div>
  <div class="controls needs-js">
    <label class="field"><span>Angle of the run <output data-read-angle-out>60 degrees right</output></span><input class="range" type="range" min="-180" max="180" step="5" value={angle} data-read-angle aria-label="Angle of the waggle run from straight up, negative to the left" /></label>
  </div>
  <div class="controls needs-js">
    <label class="field"><span>Length of the run <output data-read-sec-out>2.0 seconds</output></span><input class="range" type="range" min="0.2" max="6" step="0.1" value={seconds} data-read-sec aria-label="Length of the waggle run in seconds" /></label>
  </div>
  <p class="status" aria-live="polite" data-read-status>
    The run points {fmtAngle(angle)} and lasts {seconds.toFixed(1)} seconds. The sun is in the south, so the flowers lie to the {compass(bearing)} of the hive, about {seconds.toFixed(1)} km away.
  </p>
</div>
