---
// Part 1: one day, two dates. Without a script the table lists the gap between the calendars at five dates.
import { gap } from '../../lib/cal';
const rows = [
  { when: 'Spring 1582', y: 1582, m: 3, d: 1 },
  { when: 'Spring 1700', y: 1700, m: 3, d: 1 },
  { when: 'Spring 1900', y: 1900, m: 3, d: 1 },
  { when: 'Spring 2026', y: 2026, m: 3, d: 1 },
  { when: 'Spring 2100', y: 2100, m: 3, d: 1 },
];
---

<div class="tool" data-convert-tool>
  <table class="times">
    <caption class="sr-only">How many days the Gregorian date is ahead of the Julian date, at five times</caption>
    <thead><tr><th scope="col">Time</th><th scope="col">Gregorian date is ahead by</th></tr></thead>
    <tbody>{rows.map((r) => <tr><th scope="row">{r.when}</th><td>{gap(r.y, r.m, r.d)} days</td></tr>)}</tbody>
  </table>
  <div class="controls needs-js" data-convert-picks></div>
  <div class="controls needs-js">
    <label class="field small"><span>Day</span><input class="num" type="number" min="1" max="31" value="1" data-convert-d aria-label="Day of the month" /></label>
    <label class="field small"><span>Month</span><select class="num" data-convert-m aria-label="Month"></select></label>
    <label class="field small"><span>Year</span><input class="num" type="number" min="1" max="2400" value="1600" data-convert-y aria-label="Year" /></label>
  </div>
  <p class="status" aria-live="polite" data-convert-status>Pick a date and a calendar.</p>
</div>
