---
// Spread 1: words run together. Without a script the table gives the three lines and their readings.
import { PUZZLES } from '../../lib/quill';
---

<div class="tool" data-run-tool>
  <p class="run" data-run-line aria-label="The letters to split into words">{PUZZLES[0].run}</p>
  <table class="times">
    <caption class="sr-only">Three lines with no spaces, and how they read</caption>
    <thead><tr><th scope="col">Letters</th><th scope="col">Reading</th></tr></thead>
    <tbody>{PUZZLES.map((p) => <tr><th scope="row" class="mono">{p.run}</th><td>{p.readings.join(' or ')}</td></tr>)}</tbody>
  </table>
  <div class="controls needs-js">
    {PUZZLES.map((_, i) => <button class="pick" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-run-pick={i}>Line {i + 1}</button>)}
  </div>
  <div class="controls needs-js">
    <label class="field"><span>Words</span><input class="text long" type="text" value="" data-run-input autocomplete="off" spellcheck="false" aria-label="The same letters with spaces between the words" /></label>
    <button class="btn" type="button" data-run-show>Show the readings</button>
  </div>
  <p class="status" aria-live="polite" data-run-status>Type the letters again with spaces between the words.</p>
</div>
