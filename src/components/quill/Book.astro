---
// The whole page: an open book with three spreads. They are the Panel components and src/scripts/quill.
// Without a script each spread shows one picture or table.
import '../../styles/quill.css';
import { intro, panels } from '../../data/quill';
import PanelRun from './PanelRun.astro';
import PanelComma from './PanelComma.astro';
import PanelTime from './PanelTime.astro';

const tools: Record<string, typeof PanelRun> = { run: PanelRun, comma: PanelComma, time: PanelTime };
---

<div class="quill" data-quill>
  <section class="opening" aria-labelledby="quill-intro">
    <div class="wrap">
      <p class="kicker">Title page</p>
      <h2 id="quill-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  <div class="spreads">
    {
      panels.map((p) => {
        const Tool = tools[p.id];
        return (
          <section class="spread" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
            <div class="leaf left">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="leaf right">
              <Tool />
            </div>
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import '../../scripts/quill/quill';
</script>
