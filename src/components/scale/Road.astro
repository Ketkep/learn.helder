---
// The whole page: a long road from the Sun with four things to try. They are the Panel components and src/scripts/scale.
// Without a script each part shows one table.
import '../../styles/scale.css';
import { intro, panels } from '../../data/scale';
import PanelShrink from './PanelShrink.astro';
import PanelWalk from './PanelWalk.astro';
import PanelGuess from './PanelGuess.astro';
import PanelTrip from './PanelTrip.astro';

const tools: Record<string, typeof PanelShrink> = { shrink: PanelShrink, walk: PanelWalk, guess: PanelGuess, trip: PanelTrip };
---

<div class="scale" data-scale>
  <section class="panel opening" aria-labelledby="scale-intro">
    <div class="panel-inner">
      <div class="words">
        <p class="kicker">Start walking</p>
        <h2 id="scale-intro">{intro.title}</h2>
        {intro.paras.map((p) => <p class="para">{p}</p>)}
      </div>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="panel" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="panel-inner">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/scale/scale';
</script>
