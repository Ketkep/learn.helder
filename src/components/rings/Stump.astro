---
// The whole page: four cuts through a tree. The cuts are the Panel components and src/scripts/rings.
// Without a script each cut shows one picture or table.
import '../../styles/rings.css';
import { intro, panels } from '../../data/rings';
import PanelGrow from './PanelGrow.astro';
import PanelCount from './PanelCount.astro';
import PanelMatch from './PanelMatch.astro';
import PanelLong from './PanelLong.astro';

const tools: Record<string, typeof PanelGrow> = { grow: PanelGrow, count: PanelCount, match: PanelMatch, long: PanelLong };
---

<div class="rings" data-rings>
  <section class="panel opening" aria-labelledby="rings-intro">
    <div class="panel-inner">
      <div class="words">
        <p class="kicker">Cut across the trunk</p>
        <h2 id="rings-intro">{intro.title}</h2>
        {intro.paras.map((p) => <p class="para">{p}</p>)}
      </div>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="panel" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="panel-inner">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/rings/rings';
</script>
