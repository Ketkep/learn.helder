---
// The whole page: a flower head in three rings, one thing to try in each. They are the Panel components and src/scripts/phyllo.
// Without a script each ring shows one picture.
import '../../styles/phyllo.css';
import { intro, rings } from '../../data/phyllo';
import PanelTurn from './PanelTurn.astro';
import PanelCount from './PanelCount.astro';
import PanelGaps from './PanelGaps.astro';

const tools: Record<string, typeof PanelTurn> = { turn: PanelTurn, count: PanelCount, gaps: PanelGaps };
---

<div class="phyllo" data-phyllo>
  <section class="opening" aria-labelledby="phyllo-intro">
    <div class="wrap">
      <p class="kicker">The head</p>
      <h2 id="phyllo-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  {
    rings.map((p, i) => {
      const Tool = tools[p.id];
      return (
        <section class={`ring ring-${i + 1}`} id={`ring-${p.id}`} aria-labelledby={`ring-${p.id}-h`}>
          <div class="ring-in">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`ring-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/phyllo/phyllo';
</script>
