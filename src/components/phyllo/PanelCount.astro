---
// Ring 2: count the spiral arms. Without a script the picture shows 21 arms and the table lists the Fibonacci numbers.
import { GOLDEN, headSvg } from '../../lib/phyllo';
---

<div class="tool" data-count-tool>
  <svg class="plate round" viewBox="0 0 300 300" role="img" aria-label="A head of 500 seeds at the golden angle, with 21 spiral arms picked out in two colours." data-count-svg>
    <g set:html={headSvg(GOLDEN, 500, 21)} data-count-g></g>
  </svg>
  <table class="times">
    <caption class="sr-only">Pairs of neighbouring Fibonacci numbers of spiral arms</caption>
    <thead><tr><th scope="col">Arms one way</th><th scope="col">Arms the other way</th></tr></thead>
    <tbody>{[[5, 8], [8, 13], [13, 21], [21, 34], [34, 55]].map(([a, b]) => <tr><th scope="row">{a}</th><td>{b}</td></tr>)}</tbody>
  </table>
  <div class="controls needs-js" data-count-picks></div>
  <p class="status" aria-live="polite" data-count-status>The seeds picked out make 21 arms curving one way. The other way there are 34, or 13.</p>
</div>
