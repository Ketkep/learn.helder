---
// String 1: a long string with a bridge you can drag. A shorter string sounds higher.
// Without a script this is a drawing of the string with the bridge at half way.
const X0 = 70;
const X1 = 930;
const marks = [
  { f: 1, label: 'whole' },
  { f: 1 / 2, label: '1/2' },
  { f: 1 / 3, label: '1/3' },
  { f: 1 / 4, label: '1/4' },
];
---

<div class="lesson-tool" data-length-tool>
  <p class="readout" aria-live="polite"><span class="readout-hz" data-length-hz>220 Hz</span> <span class="readout-note" data-length-note>closest note A3</span></p>
  <div class="board">
    <svg viewBox="0 0 1000 215" role="img" aria-label="A guitar-like string seen from above, with a movable orange bridge. The part of the string between the left end and the bridge can shake.">
      <rect class="wood" x="0" y="0" width="1000" height="215" rx="14" />
      <circle class="hole" cx="800" cy="125" r="62" />
      <rect class="saddle" x={X0 - 8} y="70" width="10" height="110" rx="3" />
      <rect class="saddle" x={X1 - 2} y="70" width="10" height="110" rx="3" />
      <g class="ticks" aria-hidden="true">
        {marks.map((m) => <line x1={X0 + (X1 - X0) * m.f} x2={X0 + (X1 - X0) * m.f} y1="188" y2="206" />)}
      </g>
      <path class="string dead" data-length-dead d={`M${X0 + (X1 - X0) / 2} 125L${X1} 125`} />
      <path class="string" data-length-string d={`M${X0} 125L${X0 + (X1 - X0) / 2} 125`} />
      <g class="bridge" data-length-bridge transform={`translate(${X0 + (X1 - X0) / 2} 125)`}>
        <rect class="bridge-post" x="-5" y="-48" width="10" height="96" rx="4" />
        <circle class="bridge-knob" r="20" />
      </g>
    </svg>
    <div class="tick-row" aria-hidden="true">
      {marks.map((m) => <span style={`left: ${((X0 + (X1 - X0) * m.f) / 10).toFixed(2)}%`}>{m.label}</span>)}
    </div>
  </div>
  <div class="controls needs-js">
    <label class="field">
      <span>Shaking length <output data-length-out>1/2</output></span>
      <input class="range" type="range" min="20" max="100" step="1" value="50" data-length-range aria-label="Length of the string that can shake, as a percentage of the whole string" />
    </label>
    <button type="button" class="btn fill" data-length-pluck>Pluck</button>
  </div>
  <div class="controls needs-js" role="group" aria-label="Jump to a length">
    <button type="button" class="btn" data-length-jump="100">Whole</button>
    <button type="button" class="btn" data-length-jump="50">Half</button>
    <button type="button" class="btn" data-length-jump="25">A quarter</button>
  </div>
  <p class="status" aria-live="polite" data-length-status>
    Half the string shakes: 220 vibrations a second, one octave above the whole string.
  </p>
</div>
