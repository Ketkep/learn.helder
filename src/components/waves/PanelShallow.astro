---
// Stretch 2: a very long wave feels the sea floor. Without a script the picture shows 4000 metres and the table lists four depths.
import { fmt, kmh, shallowSpeed, shallowSvg } from '../../lib/waves';
---

<div class="tool" data-shallow-tool>
  <svg class="plate" viewBox="0 0 300 170" role="img" aria-label="A long wave on the sea over a sea floor four thousand metres down." data-shallow-svg>
    <g set:html={shallowSvg(4000)} data-shallow-g></g>
  </svg>
  <table class="times">
    <caption class="sr-only">Speed of a long wave over four depths</caption>
    <thead><tr><th scope="col">Depth</th><th scope="col">Speed</th></tr></thead>
    <tbody>{[4000, 1000, 100, 10].map((d) => <tr><th scope="row">{fmt(d)} m</th><td>{fmt(shallowSpeed(d), 1)} m/s, {fmt(kmh(shallowSpeed(d)))} km/h</td></tr>)}</tbody>
  </table>
  <div class="controls needs-js">
    <label class="field"><span>Depth <output data-shallow-out>4000</output> m</span><input class="range" type="range" min="0" max="3" step="0.02" value="3" data-shallow-range aria-label="Depth of the water, on a log scale from 4 to 4000 metres" /></label>
  </div>
  <p class="status" aria-live="polite" data-shallow-status>In 4000 metres of water a long wave goes {fmt(shallowSpeed(4000), 1)} metres a second, which is {fmt(kmh(shallowSpeed(4000)))} kilometres an hour.</p>
</div>
