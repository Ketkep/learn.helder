---
// The whole page: a shoreline with three stretches, one thing to try on each. They are the Panel components and src/scripts/waves.
// Without a script each stretch shows one picture or table.
import '../../styles/waves.css';
import { intro, stretches } from '../../data/waves';
import PanelDeep from './PanelDeep.astro';
import PanelShallow from './PanelShallow.astro';
import PanelBeach from './PanelBeach.astro';

const tools: Record<string, typeof PanelDeep> = { deep: PanelDeep, shallow: PanelShallow, beach: PanelBeach };
---

<div class="waves" data-waves>
  <section class="opening" aria-labelledby="waves-intro">
    <div class="wrap">
      <p class="kicker">The shore</p>
      <h2 id="waves-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  <div class="stretches">
    {
      stretches.map((p) => {
        const Tool = tools[p.id];
        return (
          <section class="stretch" id={`stretch-${p.id}`} aria-labelledby={`stretch-${p.id}-h`}>
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`stretch-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import '../../scripts/waves/waves';
</script>
