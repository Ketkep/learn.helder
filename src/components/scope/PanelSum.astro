---
// Screen 2: add harmonics.
import { HARMONICS, peak, recipes, scopeSvg, sumWave } from '../../lib/wave';
const r = recipes.square;
const w = sumWave(r.amps, r.signs);
---

<div class="tool" data-sum-tool>
  <svg class="screen" viewBox="0 0 300 120" role="img" aria-label="A wave made by adding sine waves" data-sum-svg>
    <rect class="glass" x="2" y="2" width="296" height="116" rx="8"></rect>
    <g set:html={scopeSvg(w, 2, 1 / peak(r.amps, r.signs))} data-sum-g></g>
  </svg>
  <div class="controls needs-js" role="group" aria-label="Pick a shape">
    {Object.entries(recipes).map(([k, v]) => <button type="button" class="pick" aria-pressed={k === 'square' ? 'true' : 'false'} data-sum-pick={k}>{v.name}</button>)}
  </div>
  <div class="needs-js sliders">
    {Array.from({ length: HARMONICS }, (_, i) => <div class="controls"><label class="field"><span>Harmonic {i + 1} <output data-sum-out={i}>{Math.round(r.amps[i] * 100)}</output></span><input class="range" type="range" min="0" max="100" step="1" value={Math.round(r.amps[i] * 100)} data-sum-range={i} aria-label={`Height of harmonic ${i + 1}`} /></label></div>)}
  </div>
  <div class="controls needs-js">
    <button type="button" class="btn fill" data-sum-play>Play this sound</button>
  </div>
  <p class="status" aria-live="polite" data-sum-status>The square wave is the odd harmonics 1, 3, 5 and 7, with heights of 1, one third, one fifth and one seventh.</p>
</div>
