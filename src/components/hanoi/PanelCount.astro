---
// Altar 3: count the moves. Without a script the table shows some sizes.
import { fewest, movesText, yearsText } from '../../lib/hanoi';
const rows = [1, 3, 5, 10, 20, 30, 64];
---

<div class="tool" data-count-tool>
  <table class="times">
    <caption class="sr-only">The fewest moves and the time at one move a second for some numbers of disks</caption>
    <thead><tr><th scope="col">Disks</th><th scope="col">Fewest moves</th><th scope="col">At one move a second</th></tr></thead>
    <tbody>{rows.map((n) => <tr><th scope="row">{n}</th><td>{n < 50 ? fewest(n).toLocaleString('en-US') : movesText(n)}</td><td>{yearsText(n)}</td></tr>)}</tbody>
  </table>
  <div class="controls needs-js">
    <label class="field"><span>Disks <output data-count-out>20</output></span><input class="range" type="range" min="1" max="64" step="1" value="20" data-count-range aria-label="Number of disks" /></label>
  </div>
  <p class="status" aria-live="polite" data-count-status>20 disks need at least 1,048,575 moves. At one move a second that takes {yearsText(20)}.</p>
</div>
