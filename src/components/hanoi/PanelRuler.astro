---
// Altar 4: which disk moves. Without a script the table shows all 15 moves for four disks.
import { binary, diskOnMove } from '../../lib/hanoi';
const rows = Array.from({ length: 15 }, (_, i) => i + 1);
---

<div class="tool" data-ruler-tool>
  <table class="times">
    <caption class="sr-only">For four disks, the move number in binary and the disk that moves</caption>
    <thead><tr><th scope="col">Move</th><th scope="col">In binary</th><th scope="col">Disk that moves</th></tr></thead>
    <tbody data-ruler-body>{rows.map((k) => <tr><th scope="row">{k}</th><td class="mono">{binary(k, 4)}</td><td>{diskOnMove(k)}</td></tr>)}</tbody>
  </table>
  <div class="controls needs-js">
    <label class="field"><span>Move <output data-ruler-out>1</output></span><input class="range" type="range" min="1" max="15" step="1" value="1" data-ruler-range aria-label="Move number, from 1 to 15" /></label>
  </div>
  <p class="status" aria-live="polite" data-ruler-status>Move 1 is 0001 in binary. The lowest 1 is in the first place, so disk 1, the smallest, moves.</p>
</div>
