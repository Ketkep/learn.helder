---
// The whole page: a slab of stone in three bands, one thing to try in each. They are the Panel components and src/scripts/rosetta.
// Without a script each band shows one picture.
import '../../styles/rosetta.css';
import { intro, bands } from '../../data/rosetta';
import PanelThree from './PanelThree.astro';
import PanelNames from './PanelNames.astro';
import PanelMixed from './PanelMixed.astro';

const tools: Record<string, typeof PanelThree> = { three: PanelThree, names: PanelNames, mixed: PanelMixed };
---

<div class="rosetta" data-rosetta>
  <section class="opening" aria-labelledby="rosetta-intro">
    <div class="wrap">
      <p class="kicker">The stone</p>
      <h2 id="rosetta-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  <div class="bands">
    {
      bands.map((p) => {
        const Tool = tools[p.id];
        return (
          <section class="band-row" id={`band-${p.id}`} aria-labelledby={`band-${p.id}-h`}>
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`band-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import '../../scripts/rosetta/rosetta';
</script>
