---
// Band 1: one decree, three scripts. Without a script the picture shows the stone and the table says what each band is.
import { BANDS, slabSvg } from '../../lib/rosetta';
---

<div class="tool" data-three-tool>
  <svg class="plate" viewBox="0 0 300 200" role="img" aria-label="A slab of stone in three bands: hieroglyphs at the top, demotic writing in the middle and Greek letters at the bottom." data-three-svg>
    <g set:html={slabSvg('hiero')} data-three-g></g>
  </svg>
  <table class="times">
    <caption class="sr-only">The three scripts on the Rosetta Stone</caption>
    <thead><tr><th scope="col">Band</th><th scope="col">What it is</th></tr></thead>
    <tbody>{BANDS.map((b) => <tr><th scope="row">{b.name}</th><td>{b.words}</td></tr>)}</tbody>
  </table>
  <div class="controls needs-js" data-three-picks></div>
  <p class="status" aria-live="polite" data-three-status>{BANDS[0].words}</p>
</div>
