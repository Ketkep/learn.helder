---
// Shot 1: a pinhole.
import { bestHole, pinholeBlur, pinholeLight, pinholeSvg } from '../../lib/camera';
const d = 1;
---

<div class="tool" data-pinhole-tool>
  <svg class="strip" viewBox="0 0 300 130" role="img" aria-label="An upside down picture of an arrow and a sun on the back wall of a pinhole box" data-pinhole-svg>
    <rect class="stage" x="2" y="2" width="296" height="126" rx="8"></rect>
    <g set:html={pinholeSvg(d)} data-pinhole-g></g>
  </svg>
  <div class="controls needs-js">
    <label class="field"><span>Hole <output data-pinhole-out>{d.toFixed(1)} mm</output></span><input class="range" type="range" min="0.1" max="3" step="0.05" value={d} data-pinhole-range aria-label="Width of the hole in millimetres" /></label>
  </div>
  <p class="status" aria-live="polite" data-pinhole-status>
    A hole of {d.toFixed(1)} mm lets in {pinholeLight(d).toFixed(1)} times the light of a 1 mm hole, and blurs the picture over about {pinholeBlur(d).toFixed(1)} mm. In this toy box the sharpest picture comes from a hole of about {bestHole().toFixed(2)} mm.
  </p>
</div>
