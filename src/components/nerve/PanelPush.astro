---
// Screen 1: the threshold. Without a script the table gives a few pushes and what they do.
import { fires, fmt, pushSvg, REST, THRESHOLD } from '../../lib/nerve';
const rows = [5, 10, 14, 15, 25, 40];
---

<div class="tool" data-push-tool>
  <svg class="plate" viewBox="0 0 300 170" role="img" aria-label="A voltage trace that sits at minus 70 millivolts, then jumps in a full spike to about plus 35 and falls back below rest." data-push-svg>
    <rect class="stage" x="1" y="1" width="298" height="168" rx="8"></rect>
    <g set:html={pushSvg(25)} data-push-g></g>
  </svg>
  <table class="times">
    <caption class="sr-only">What a push of each size does to a cell at rest</caption>
    <thead><tr><th scope="col">Push</th><th scope="col">Voltage reached</th><th scope="col">Result</th></tr></thead>
    <tbody>{rows.map((p) => <tr><th scope="row">{p} mV</th><td>{REST + p} mV</td><td>{fires(p) ? 'Full spike' : `Fades. The threshold is ${THRESHOLD}`}</td></tr>)}</tbody>
  </table>
  <div class="controls needs-js">
    <label class="field"><span>Push <output data-push-out>25</output> mV</span><input class="range" type="range" min="0" max="40" step="1" value="25" data-push-range aria-label="Size of the push in millivolts" /></label>
  </div>
  <p class="status" aria-live="polite" data-push-status>A push of 25 mV lifts the cell from {REST} to {REST + 25} mV, past the threshold of {THRESHOLD}, so there is a full spike.</p>
</div>
