---
// Board 1: Kepler's third law. Without a script the picture shows Jupiter's distance and the table checks five planets.
import { PLANETS, fmt, lawSvg, ratio, years } from '../../lib/kepler';
---

<div class="tool" data-law-tool>
  <svg class="plate" viewBox="0 0 300 170" role="img" aria-label="A chalk graph on log scales of the time of one orbit against distance for five planets. They lie on a straight line." data-law-svg>
    <g set:html={lawSvg(5.203)} data-law-g></g>
  </svg>
  <table class="times">
    <caption class="sr-only">Time squared over distance cubed for five planets, in years and astronomical units</caption>
    <thead><tr><th scope="col">Planet</th><th scope="col">Distance</th><th scope="col">Years</th><th scope="col">Years² over distance³</th></tr></thead>
    <tbody>{PLANETS.map((p) => <tr><th scope="row">{p.name}</th><td>{p.au} AU</td><td>{fmt(p.days / 365.25, 2)}</td><td>{fmt(ratio(p), 3)}</td></tr>)}</tbody>
  </table>
  <div class="controls needs-js">
    <label class="field"><span>Distance <output data-law-out>5.2</output> AU</span><input class="range" type="range" min="0.3" max="10" step="0.1" value="5.2" data-law-range aria-label="Distance from the Sun in astronomical units" /></label>
  </div>
  <p class="status" aria-live="polite" data-law-status>A planet 5.2 astronomical units from the Sun takes {fmt(years(5.2), 2)} years for one orbit.</p>
</div>
