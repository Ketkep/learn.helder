---
// The whole page: a rain shower with four things to try. They are the Panel components and src/scripts/bow.
// Without a script each part shows one picture.
import '../../styles/bow.css';
import { intro, panels } from '../../data/bow';
import PanelDrop from './PanelDrop.astro';
import PanelColours from './PanelColours.astro';
import PanelSky from './PanelSky.astro';
import PanelSecond from './PanelSecond.astro';

const tools: Record<string, typeof PanelDrop> = { drop: PanelDrop, colours: PanelColours, sky: PanelSky, second: PanelSecond };
---

<div class="bow" data-bow>
  <section class="panel opening" aria-labelledby="bow-intro">
    <div class="panel-inner">
      <div class="words">
        <p class="kicker">Back to the Sun</p>
        <h2 id="bow-intro">{intro.title}</h2>
        {intro.paras.map((p) => <p class="para">{p}</p>)}
      </div>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="panel" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="panel-inner">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/bow/bow';
</script>
