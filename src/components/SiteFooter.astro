---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <div class="about">
      <p class="name">Helder Labs Learn</p>
      <p>Set in Young Serif and Hanken Grotesk. No cookies, no tracking.</p>
    </div>
    <ul class="links">
      <li><a href="https://helderlabs.com">helderlabs.com</a></li>
      <li><a href="https://games.helderlabs.com">games.helderlabs.com</a></li>
    </ul>
    <p class="copy">&copy; {year} Helder Labs</p>
  </div>
</footer>

<style>
  /* The baseboard: a dark strip under the wall */
  .site-footer {
    margin-top: clamp(4rem, 9vw, 7rem);
    background: var(--footer-bg);
    color: var(--footer-fg);
  }

  .inner {
    display: grid;
    gap: 1.5rem 2rem;
    padding-block: 2.75rem 3rem;
  }

  .about {
    display: grid;
    gap: 0.3rem;
    font-size: 0.95rem;
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.1;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    font-weight: 600;
  }

  .links a {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .copy {
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .site-footer :focus-visible {
    outline-color: var(--footer-fg);
  }

  @media (min-width: 48rem) {
    .inner {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .copy {
      grid-column: 1 / -1;
    }
  }
</style>
