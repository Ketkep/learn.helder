---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <p class="made">
      <strong>Helder Labs Learn</strong>
      <span>This site uses no cookies and does no tracking.</span>
    </p>
    <ul class="links">
      <li><a href="https://helderlabs.com">helderlabs.com</a></li>
      <li><a href="https://games.helderlabs.com">games.helderlabs.com</a></li>
    </ul>
    <p class="copy">&copy; {year} Helder Labs</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4rem, 9vw, 7rem);
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .inner {
    display: grid;
    gap: 1.5rem 2rem;
    padding-block: 2.5rem 3rem;
  }

  .made {
    display: grid;
    gap: 0.25rem;
  }

  .made strong {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--ink);
  }

  .made span,
  .copy {
    font-size: 0.95rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    font-weight: 500;
  }

  .links a {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  @media (min-width: 48rem) {
    .inner {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .copy {
      grid-column: 1 / -1;
    }
  }
</style>
