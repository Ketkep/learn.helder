---
// Fire 2: in one second the ball falls and the ground curves away.
import { curveDrop, fallDrop, getPlanet } from '../../lib/orbit';
const earth = getPlanet('earth');
const rows = [1, 3, 5, 7.9, 10];
---

<div class="tool" data-second-tool>
  <svg class="orbitpic" viewBox="0 0 400 200" role="img" aria-label="A ball flying sideways while the ground curves away below it" data-second-svg>
    <path class="ground" d="M20 70 Q200 150 380 70 L380 200 L20 200Z"></path>
    <line class="level" x1="20" y1="70" x2="380" y2="70"></line>
    <circle class="ball" r="6" cx="20" cy="70" data-second-ball></circle>
    <circle class="ball ghost" r="6" cx="200" cy="88" data-second-fall></circle>
  </svg>
  <div class="controls needs-js">
    <label class="field">
      <span>Speed <output data-second-out>7.9 km/s</output></span>
      <input class="range" type="range" min="0" max="10" step="0.1" value="7.9" data-second-range aria-label="Speed of the ball in kilometres per second" />
    </label>
  </div>
  <p class="status" aria-live="polite" data-second-status>
    In one second a ball at 7.9 km/s flies 7.9 km sideways. It falls {fallDrop(earth, 1).toFixed(1)} metres, and the ground curves away by {curveDrop(earth, 7.9).toFixed(1)} metres: the two match, so the ball keeps falling without getting closer.
  </p>
  <table class="times">
    <caption class="sr-only">Sideways distance in one second, the curve of the ground and the fall of the ball</caption>
    <thead><tr><th scope="col">Speed</th><th scope="col">Ground curves away</th><th scope="col">Ball falls</th></tr></thead>
    <tbody>{rows.map((v) => <tr><th scope="row">{v} km/s</th><td>{curveDrop(earth, v).toFixed(1)} metres</td><td>{fallDrop(earth, 1).toFixed(1)} metres</td></tr>)}</tbody>
  </table>
</div>
