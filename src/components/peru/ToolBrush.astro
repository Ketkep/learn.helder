---
// Shot 1: a sandy hill. Wipe the sand away with a brush to find the Great Pyramid of Caral.
import { seeded } from '../../lib/rand';
import { smooth } from '../../lib/svgpath';

interface Props {
  chyron: string;
}
const { chyron } = Astro.props;

// The pyramid in front view: five terraces and a small temple on top
const BASE = 392;
const tiers = [440, 360, 280, 200, 130].map((w, i) => ({ x: 400 - w / 2, y: BASE - 30 * (i + 1), w }));

// The sand mound that hides it: a smooth shape a little bigger than the pyramid
const mound = smooth(
  [
    [112, 408],
    [150, 392],
    [168, 350],
    [212, 338],
    [222, 312],
    [262, 296],
    [292, 280],
    [326, 252],
    [352, 226],
    [378, 200],
    [400, 192],
    [422, 200],
    [448, 226],
    [474, 252],
    [508, 280],
    [538, 296],
    [578, 312],
    [588, 338],
    [632, 350],
    [650, 392],
    [688, 408],
  ],
  false,
) + 'L688 412L112 412Z';

// Grains of sand on the mound, always in the same places
const rnd = seeded(7);
const grains = Array.from({ length: 150 }, () => ({
  x: 130 + rnd() * 540,
  y: 200 + rnd() * 205,
  r: 1 + rnd() * 1.6,
}));
---

<figure class="frame tool-brush" data-brush-tool>
  <svg viewBox="0 0 800 450" role="img" aria-label="A sandy hill in the desert. Under the sand there is a stepped pyramid." data-brush-svg>
    <defs>
      <mask id="peru-sand-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="800" height="450">
        <rect x="0" y="0" width="800" height="450" fill="#fff" />
        <g data-brushed fill="#000"></g>
      </mask>
    </defs>

    <rect x="0" y="0" width="800" height="450" fill="#bfdcf0" />
    <circle cx="676" cy="92" r="34" fill="#ff7a45" stroke="#121315" stroke-width="4" />
    <polygon points="0,300 90,236 170,276 270,206 380,284 470,240 560,288 660,226 800,284 800,340 0,340" fill="#c9ad82" />
    <polygon points="0,330 120,292 230,326 360,300 500,332 640,298 800,326 800,360 0,360" fill="#b99660" />
    <rect x="0" y="352" width="800" height="98" fill="#d9b878" />

    <!-- The pyramid, as it looks once it is clean -->
    <g class="pyr">
      {
        tiers.map((t, i) => (
          <>
            <rect x={t.x} y={t.y} width={t.w} height="30" fill={i % 2 ? '#c98d52' : '#d9a566'} stroke="#8c5a31" stroke-width="2" />
            <rect x={t.x} y={t.y} width={t.w} height="6" fill="#ecc88f" />
          </>
        ))
      }
      <rect x="365" y="214" width="70" height="28" fill="#c98d52" stroke="#8c5a31" stroke-width="2" />
      <rect x="386" y="222" width="28" height="20" fill="#3b2a1c" />
      <rect x="372" y="206" width="56" height="8" fill="#ecc88f" stroke="#8c5a31" stroke-width="2" />
      <!-- the staircase up the middle -->
      <rect x="372" y="242" width="56" height="150" fill="#f3dcb0" stroke="#8c5a31" stroke-width="2" />
      {Array.from({ length: 14 }, (_, i) => <line x1="372" x2="428" y1={250 + i * 10.4} y2={250 + i * 10.4} stroke="#b88a52" stroke-width="2" />)}
    </g>

    <!-- The sand on top. Brushing makes holes in it. -->
    <g class="sand" mask="url(#peru-sand-mask)" data-sand>
      <path d={mound} fill="#e9d09a" stroke="#c9a96a" stroke-width="3" />
      {grains.map((g) => <circle cx={g.x} cy={g.y} r={g.r} fill="#c9a96a" opacity="0.7" />)}
    </g>
    <path d={mound} fill="#000" opacity="0" pointer-events="none" data-mound />

    <!-- A tent and a sign: the dig site -->
    <polygon points="38,398 114,398 76,332" fill="#f2e7cf" stroke="#121315" stroke-width="3" stroke-linejoin="round" />
    <polygon points="64,398 88,398 76,362" fill="#2a1f17" />
    <line x1="76" y1="332" x2="76" y2="316" stroke="#121315" stroke-width="3" />
    <polygon points="76,316 98,322 76,328" fill="#e4501a" />
    <rect x="712" y="344" width="6" height="54" fill="#6a4426" />
    <rect x="690" y="330" width="50" height="26" rx="3" fill="#f2e7cf" stroke="#121315" stroke-width="3" />
    <line x1="698" y1="339" x2="732" y2="339" stroke="#121315" stroke-width="3" stroke-linecap="round" />
    <line x1="698" y1="347" x2="722" y2="347" stroke="#121315" stroke-width="3" stroke-linecap="round" />

    <g data-dust></g>

    <!-- The brush that follows your finger or mouse. Its tip is at the pointer. -->
    <g class="brush" data-brush transform="translate(-200 -200)" aria-hidden="true">
      <g transform="rotate(32)">
        <path d="M0 0L-9 -28H9Z" fill="#ead6a6" stroke="#121315" stroke-width="2.5" stroke-linejoin="round" />
        <rect x="-10" y="-40" width="20" height="12" fill="#9aa0a8" stroke="#121315" stroke-width="2.5" />
        <path d="M-7 -40L-5 -112H5L7 -40Z" fill="#8a542b" stroke="#121315" stroke-width="2.5" stroke-linejoin="round" />
      </g>
    </g>
  </svg>
  <figcaption class="chyron">{chyron}</figcaption>
</figure>

<div class="controls">
  <button type="button" class="btn fill" data-brush-auto>Brush it clean for me</button>
  <button type="button" class="btn" data-brush-reset disabled>Cover it again</button>
</div>
<p class="status" aria-live="polite" data-brush-status>Wipe the sand away: drag across the hill. On a touch screen, swipe left and right.</p>

<style>
  .tool-brush svg {
    /* Up and down still scrolls the page. Sideways drags brush the sand. */
    touch-action: pan-y;
  }

  /* The brush replaces the pointer, but only when scripts are running to draw it */
  :global(html.js) .tool-brush svg {
    cursor: none;
  }

  /* Without scripts the sand cannot be brushed, so show the pyramid at once */
  :global(html:not(.js)) .tool-brush .sand,
  :global(html:not(.js)) .tool-brush .brush,
  :global(html:not(.js)) .tool-brush ~ .controls {
    display: none;
  }

  .tool-brush .sand {
    transition: opacity 0.9s;
  }

  .tool-brush[data-clean] .sand {
    opacity: 0;
  }

  .tool-brush .brush {
    pointer-events: none;
  }

  .tool-brush[data-clean] .brush {
    display: none;
  }

  :global(.dust-puff) {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.dust-puff) {
      animation: puff 0.9s ease-out forwards;
    }
  }

  @keyframes puff {
    from {
      opacity: 0.75;
      transform: translateY(0);
    }

    to {
      opacity: 0;
      transform: translateY(-14px);
    }
  }
</style>
