---
// Message 1: a telegraph key. Hold for a dot, hold longer for a dash, wait between letters.
// Without a script this is a drawing of the key and the word SOS.
---

<div class="tool" data-key-tool>
  <div class="paper">
    <p class="mono big" data-key-signs aria-live="polite">&middot;&middot;&middot; &minus;&minus;&minus; &middot;&middot;&middot;</p>
    <p class="mono letters" data-key-letters>S O S</p>
  </div>
  <div class="needs-js key-area">
    <button type="button" class="key" data-key-press aria-describedby="key-help">
      <span class="key-knob"></span>
      <span class="key-label">Hold me</span>
    </button>
    <p class="hint" id="key-help">Press and hold with the mouse, a finger or the space bar.</p>
  </div>
  <div class="controls needs-js" role="group" aria-label="Buttons instead of timing">
    <button type="button" class="btn" data-key-add=".">Dot</button>
    <button type="button" class="btn" data-key-add="-">Dash</button>
    <button type="button" class="btn" data-key-add="|">End letter</button>
    <button type="button" class="btn" data-key-add=" ">Space</button>
  </div>
  <div class="controls needs-js">
    <label class="field">
      <span>Beat <output data-key-unit-out>120 ms</output></span>
      <input class="range" type="range" min="60" max="300" step="10" value="120" data-key-unit aria-label="Length of one beat in milliseconds" />
    </label>
    <button type="button" class="btn" data-key-clear>Clear</button>
  </div>
  <p class="status" aria-live="polite" data-key-status>
    The tape shows the word SOS. Press the key to make your own message.
  </p>
</div>
