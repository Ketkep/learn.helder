---
// Strip 1: The loop.
import { chartSvg, simulate, type Setup } from '../../lib/thermostat';
const s: Setup = { outside: 5, set: 20, band: 2, leak: 0.1, lag: 0 };
const r = simulate(s);
const pct = Math.round(r.onShare * 100);
---

<div class="tool" data-loop-tool>
  <svg class="strip" viewBox="0 0 300 180" role="img" aria-label="A chart of the room temperature over 24 hours with the times the heater is on" data-loop-svg>
    <rect class="paper" x="2" y="2" width="296" height="176" rx="8"></rect>
    <g data-loop-g set:html={chartSvg(s, r)}></g>
  </svg>
  <div class="controls needs-js">
    <label class="field"><span>Temperature you want <output data-loop-set-out>20 degrees</output></span><input class="range" type="range" min="15" max="24" step="1" value="20" data-loop-set aria-label="Temperature you ask for in degrees Celsius" /></label>
  </div>
  <div class="controls needs-js">
    <label class="field"><span>Outside <output data-loop-out-out>5 degrees</output></span><input class="range" type="range" min="-10" max="20" step="1" value="5" data-loop-out aria-label="Temperature outside in degrees Celsius" /></label>
  </div>
  <p class="status" aria-live="polite" data-loop-status>
    The room stayed between {r.min.toFixed(1)} and {r.max.toFixed(1)} degrees. The heater switched {r.switches} times and was on {pct} per cent of the day.{r.needed > 1 ? ' It was too small to hold the set point.' : ''}
  </p>
</div>
