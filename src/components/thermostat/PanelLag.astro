---
// Strip 4: A slow heater.
import { chartSvg, simulate, type Setup } from '../../lib/thermostat';
const s: Setup = { outside: 5, set: 20, band: 1, leak: 0.1, lag: 0.5 };
const r = simulate(s);
const pct = Math.round(r.onShare * 100);
---

<div class="tool" data-lag-tool>
  <svg class="strip" viewBox="0 0 300 180" role="img" aria-label="A chart of the room temperature over 24 hours with the times the heater is on" data-lag-svg>
    <rect class="paper" x="2" y="2" width="296" height="176" rx="8"></rect>
    <g data-lag-g set:html={chartSvg(s, r)}></g>
  </svg>
  <div class="controls needs-js">
    <label class="field"><span>Heater lag <output data-lag-lag-out>0.5 hours</output></span><input class="range" type="range" min="0" max="1.5" step="0.1" value="0.5" data-lag-lag aria-label="How slowly the heater warms up and cools down in hours" /></label>
  </div>
  <p class="status" aria-live="polite" data-lag-status>
    The room stayed between {r.min.toFixed(1)} and {r.max.toFixed(1)} degrees. The heater switched {r.switches} times and was on {pct} per cent of the day.{r.needed > 1 ? ' It was too small to hold the set point.' : ''}
  </p>
</div>
