---
// The guilder: the orange knob of the site, with a ship on one side and an empty sea on the other.
// The edge ticks make it easy to see the coin turn while it rolls.
interface Props {
  side?: 'front' | 'back';
}
const { side = 'front' } = Astro.props;

const ticks = Array.from({ length: 32 }, (_, i) => {
  const a = (i / 32) * Math.PI * 2;
  const r1 = 41.5;
  const r2 = 45;
  const p = (r: number) => `${(50 + Math.cos(a) * r).toFixed(1)} ${(50 + Math.sin(a) * r).toFixed(1)}`;
  return `M${p(r1)}L${p(r2)}`;
}).join('');
---

<svg class={`coin-svg ${side}`} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <circle class="disc" cx="50" cy="50" r="47" />
  <path class="ticks" d={ticks} />
  <circle class="rim" cx="50" cy="50" r="36" />
  {
    side === 'front' ? (
      <g class="mark">
        <path d="M50 24V66" class="mast" />
        <path d="M50 28Q62 31 62 41Q56 44 50 41Z" class="sail" />
        <path d="M50 44Q65 47 65 58Q57 61 50 58Z" class="sail" />
        <path d="M50 28Q39 31 39 41Q44 44 50 41Z" class="sail" />
        <path d="M33 62H67L61 72Q50 76 39 72Z" class="hull" />
      </g>
    ) : (
      <g class="mark">
        <path d="M32 44q6 -6 12 0t12 0t12 0" class="wave" />
        <path d="M32 54q6 -6 12 0t12 0t12 0" class="wave" />
        <path d="M32 64q6 -6 12 0t12 0t12 0" class="wave" />
      </g>
    )
  }
  <path class="shine" d="M24 34A30 30 0 0 1 42 20" />
</svg>

<style is:global>
  .coin-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .coin-svg .disc {
    fill: #e4501a;
    fill: var(--accent);
    stroke: #14213d;
    stroke-width: 5;
  }

  .coin-svg.back .disc {
    fill: #3a4254;
  }

  .coin-svg .ticks {
    fill: none;
    stroke: #14213d;
    stroke-width: 2.2;
    stroke-linecap: round;
    opacity: 0.55;
  }

  .coin-svg .rim {
    fill: none;
    stroke: #14213d;
    stroke-width: 2.4;
    opacity: 0.7;
  }

  .coin-svg.back .rim,
  .coin-svg.back .ticks {
    stroke: #fff3dc;
    opacity: 0.4;
  }

  .coin-svg .mast {
    stroke: #14213d;
    stroke-width: 2.4;
    stroke-linecap: round;
    fill: none;
  }

  .coin-svg .sail {
    fill: #fff3dc;
    stroke: #14213d;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .coin-svg .hull {
    fill: #14213d;
    stroke: #14213d;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .coin-svg .wave {
    fill: none;
    stroke: #fff3dc;
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.45;
  }

  .coin-svg .shine {
    fill: none;
    stroke: #fff;
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.4;
  }

  .coin-svg.back .shine {
    opacity: 0.15;
  }
</style>
