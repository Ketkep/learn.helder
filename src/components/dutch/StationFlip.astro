---
// Stop 7: both sides of the coin. Flip it and the picture darkens, because everything on the
// bright side was paid for, in part, by the dark side.
import Card from './Card.astro';
import Coin from './Coin.astro';
import type { Station } from '../../data/dutch';
import { sides } from '../../data/dutch';

interface Props {
  s: Station;
}
const { s } = Astro.props;
const views = [
  { key: 'bright', ...sides.bright },
  { key: 'dark', ...sides.dark },
] as const;
---

<div class="stop">
  <div class="panel story" data-panel><Card s={s} /></div>
  <div class="panel sub" data-panel>
    <div class="widget fl-widget" data-fl>
      <button type="button" class="fl-coin needs-js" data-fl-coin aria-label="Flip the coin. It shows the bright side.">
        <span class="fl-turn" data-fl-turn>
          <span class="fl-face" data-fl-face="bright"><Coin side="front" /></span>
          <span class="fl-face" data-fl-face="dark" hidden><Coin side="back" /></span>
        </span>
      </button>
      <p class="fl-hint needs-js" aria-hidden="true">Tap the coin</p>
      <div class="fl-text" role="status" aria-live="polite" data-fl-text>
        {
          views.map((v) => (
            <section class="fl-side" data-fl-side={v.key}>
              <h3>{v.title}</h3>
              {v.paras.map((p) => <p>{p}</p>)}
            </section>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style is:global>
  .fl-widget {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, 1fr);
    grid-template-areas:
      'coin text'
      'hint text';
    align-items: start;
    gap: 0.2rem 1rem;
  }

  .fl-coin {
    grid-area: coin;
    width: 4.6rem;
    height: 4.6rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }

  .fl-turn {
    display: block;
    width: 100%;
    height: 100%;
  }

  .fl-face {
    display: block;
    width: 100%;
    height: 100%;
  }

  .fl-face[hidden] {
    display: none;
  }

  .fl-hint {
    grid-area: hint;
    justify-self: center;
    font-family: var(--font-hand);
    font-size: 1.3rem;
    line-height: 1;
  }

  .fl-text {
    grid-area: text;
    display: grid;
    min-width: 0;
  }

  .fl-side {
    display: grid;
    gap: 0.5rem;
  }

  .fl-side[hidden] {
    display: none;
  }

  .fl-side h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.05;
  }

  .fl-side p {
    font-size: 0.97rem;
    line-height: 1.45;
  }

  @media (min-width: 60rem) {
    .fl-widget {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 0.2rem 1.4rem;
    }

    .fl-coin {
      width: 9rem;
      height: 9rem;
    }
  }
</style>
