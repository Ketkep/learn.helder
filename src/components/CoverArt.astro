---
// The drawing on a cover. It is inline SVG, so it takes its colors from the cover
// around it (--cover and --on-cover) and can move when the cover is hovered (--mv).
import { getDrawing } from '../lib/previews';

interface Props {
  /** File name in src/previews, without ".svg". */
  name: string;
}

const drawing = getDrawing(Astro.props.name);
---

<div class="art" aria-hidden="true">
  <Fragment set:html={drawing} />
</div>

<style>
  .art {
    width: 100%;
    aspect-ratio: 400 / 300;
  }

  /* The SVG files use these classes. */
  .art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* .a: main shape. .b: softer shape. .c: faint shape. .cv: same as the cover (knocked out). */
  .art :global(.a) {
    fill: var(--on-cover);
  }

  .art :global(.b) {
    fill: color-mix(in oklab, var(--cover) 45%, var(--on-cover));
  }

  .art :global(.c) {
    fill: color-mix(in oklab, var(--cover) 84%, var(--on-cover));
  }

  .art :global(.cv) {
    fill: var(--cover);
  }

  /* .l: a line. .dash: a dotted line. */
  .art :global(.l) {
    fill: none;
    stroke: var(--on-cover);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .art :global(.dash) {
    stroke-width: 4;
    stroke-dasharray: 0.5 10;
  }

  /* The knob: the one orange thing on every cover */
  .art :global(.knob) {
    fill: var(--accent);
    stroke: var(--on-cover);
    stroke-width: 3;
  }

  .art :global(text) {
    fill: var(--on-cover);
    font: 600 15px var(--font-body);
  }

  /* .m moves by --dx and --dy, .grow stretches upwards by --g. Both wait --i steps. */
  .art :global(.m) {
    transform: translate(calc(var(--mv, 0) * var(--dx, 0px)), calc(var(--mv, 0) * var(--dy, 0px)));
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i, 0) * 45ms);
  }

  .art :global(.grow) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transform: scaleY(calc(1 + var(--mv, 0) * var(--g, 0.1)));
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i, 0) * 45ms);
  }

  /* Two labels that swap places: shows "walk" at rest and "will walk" on hover */
  .art :global(.swap-a) {
    opacity: calc(1 - var(--mv, 0));
    transition: opacity 0.4s;
  }

  .art :global(.swap-b) {
    opacity: var(--mv, 0);
    transition: opacity 0.4s 0.35s;
  }
</style>
