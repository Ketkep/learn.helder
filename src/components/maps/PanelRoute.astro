---
// Look 3: the shortest route and the constant compass bearing route between two cities.
import Twin from './Twin.astro';
import ProjectionSelect from './ProjectionSelect.astro';
import { routeLayers } from '../../lib/maplayers';
import { cities, greatCircleKm, rhumbKm } from '../../lib/projections';
const [from, to] = [cities[0], cities[1]];
const layers = routeLayers('mercator', from, to);
const round10 = (n: number) => Math.round(n / 10) * 10;
const [gc, rh] = [round10(greatCircleKm(from, to)), round10(rhumbKm(from, to))];
---

<div class="tool" data-route-tool>
  <Twin layers={layers} label="The shortest route and the constant bearing route from London to New York" />
  <div class="controls needs-js">
    <label class="field">
      <span>From</span>
      <select class="select" data-route-from aria-label="Start city">
        {cities.map((c, i) => <option value={i} selected={c === from}>{c.name}</option>)}
      </select>
    </label>
    <label class="field">
      <span>To</span>
      <select class="select" data-route-to aria-label="End city">
        {cities.map((c, i) => <option value={i} selected={c === to}>{c.name}</option>)}
      </select>
    </label>
  </div>
  <div class="controls needs-js"><ProjectionSelect /></div>
  <p class="key" aria-hidden="true"><span class="swatch-a"></span> shortest way <span class="swatch-b"></span> constant compass bearing</p>
  <p class="status" aria-live="polite" data-route-status>
    London to New York: the shortest way is {gc.toLocaleString('en-US')} km. The constant bearing route is {rh.toLocaleString('en-US')} km, which is {(rh - gc).toLocaleString('en-US')} km longer.
  </p>
</div>
