---
// The whole page: a cone with four things to try. They are the Panel components and src/scripts/volcano.
// Without a script each part shows one picture.
import '../../styles/volcano.css';
import { intro, panels } from '../../data/volcano';
import PanelPot from './PanelPot.astro';
import PanelBubble from './PanelBubble.astro';
import PanelWhere from './PanelWhere.astro';
import PanelVei from './PanelVei.astro';

const tools: Record<string, typeof PanelPot> = { pot: PanelPot, bubble: PanelBubble, where: PanelWhere, vei: PanelVei };
---

<div class="volcano" data-volcano>
  <section class="panel opening" aria-labelledby="volcano-intro">
    <div class="panel-inner">
      <div class="words">
        <p class="kicker">Under the cone</p>
        <h2 id="volcano-intro">{intro.title}</h2>
        {intro.paras.map((p) => <p class="para">{p}</p>)}
      </div>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="panel" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="panel-inner">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/volcano/volcano';
</script>
