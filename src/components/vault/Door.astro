---
// The whole page: a vault door with three locks, one thing to try on each. They are the Panel components and src/scripts/vault.
// Without a script each lock shows one picture or table.
import '../../styles/vault.css';
import { intro, locks } from '../../data/vault';
import PanelLength from './PanelLength.astro';
import PanelWords from './PanelWords.astro';
import PanelHabit from './PanelHabit.astro';

const tools: Record<string, typeof PanelLength> = { length: PanelLength, words: PanelWords, habit: PanelHabit };
---

<div class="vault" data-vault>
  <section class="opening" aria-labelledby="vault-intro">
    <div class="wrap">
      <p class="kicker">The vault door</p>
      <h2 id="vault-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  <div class="locks">
    {
      locks.map((p) => {
        const Tool = tools[p.id];
        return (
          <section class="lock" id={`lock-${p.id}`} aria-labelledby={`lock-${p.id}-h`}>
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`lock-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import '../../scripts/vault/vault';
</script>
