---
// The whole page: a card room with four drawers. The drawers are the Panel components and src/scripts/search.
// Without a script each drawer shows one picture or table.
import '../../styles/search.css';
import { intro, panels } from '../../data/search';
import PanelCrawl from './PanelCrawl.astro';
import PanelIndex from './PanelIndex.astro';
import PanelWords from './PanelWords.astro';
import PanelLinks from './PanelLinks.astro';

const tools: Record<string, typeof PanelCrawl> = { crawl: PanelCrawl, index: PanelIndex, words: PanelWords, links: PanelLinks };
---

<div class="search" data-search>
  <section class="panel opening" aria-labelledby="search-intro">
    <div class="panel-inner">
      <div class="words">
        <p class="kicker">Open the drawers</p>
        <h2 id="search-intro">{intro.title}</h2>
        {intro.paras.map((p) => <p class="para">{p}</p>)}
      </div>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="panel" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="panel-inner">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/search/search';
</script>
