---
// The whole page: a wall of seismograph strips and a map table, with four things to try. They are the Panel components and src/scripts/quake.
// Without a script each part shows one picture or table.
import '../../styles/quake.css';
import { intro, panels } from '../../data/quake';
import PanelGap from './PanelGap.astro';
import PanelCircles from './PanelCircles.astro';
import PanelSize from './PanelSize.astro';
import PanelInside from './PanelInside.astro';

const tools: Record<string, typeof PanelGap> = { gap: PanelGap, circles: PanelCircles, size: PanelSize, inside: PanelInside };
---

<div class="quake" data-quake>
  <section class="panel opening" aria-labelledby="quake-intro">
    <div class="panel-inner">
      <div class="words">
        <p class="kicker">Read the strips</p>
        <h2 id="quake-intro">{intro.title}</h2>
        {intro.paras.map((p) => <p class="para">{p}</p>)}
      </div>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="panel" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="panel-inner">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/quake/quake';
</script>
