---
// Hour 15: where did the weight come from? Without a script the table shows the start and the end.
import { soilLb, treeLb, WILLOW } from '../../lib/photo';
---

<div class="tool" data-willow-tool>
  <div class="controls needs-js" role="group" aria-label="Where do you think the new weight came from?">
    <button type="button" class="pick" aria-pressed="false" data-willow-guess="soil">The soil</button>
    <button type="button" class="pick" aria-pressed="false" data-willow-guess="water">The water</button>
    <button type="button" class="pick" aria-pressed="false" data-willow-guess="air">The air</button>
  </div>
  <table class="times">
    <caption class="sr-only">The tree and the soil at the start and after five years</caption>
    <thead><tr><th scope="col">Year</th><th scope="col">Tree</th><th scope="col">Soil</th></tr></thead>
    <tbody data-willow-body>
      <tr><th scope="row">0</th><td>5 lb</td><td>200 lb</td></tr>
      <tr><th scope="row">5</th><td>about 169 lb</td><td>about 2 oz less</td></tr>
    </tbody>
  </table>
  <div class="controls needs-js">
    <label class="field"><span>Year <output data-willow-out>5</output></span><input class="range" type="range" min="0" max="5" step="1" value="5" data-willow-range aria-label="Years since planting" /></label>
  </div>
  <ul class="bars needs-js" data-willow-bars>
    <li><span class="bar-label">Tree</span><span class="track"><span class="fill" style={`width:${(treeLb(5) / 200) * 100}%`} data-bar="tree"></span></span><span class="bar-num" data-num="tree">{Math.round(treeLb(5))} lb</span></li>
    <li><span class="bar-label">Soil</span><span class="track"><span class="fill soil" style={`width:${(soilLb(5) / 200) * 100}%`} data-bar="soil"></span></span><span class="bar-num" data-num="soil">{Math.round(soilLb(5))} lb</span></li>
  </ul>
  <p class="status" aria-live="polite" data-willow-status>The tree went from {WILLOW.startLb} lb to about {WILLOW.endLb} lb in {WILLOW.years} years, a gain of about 164 lb. The soil lost about {WILLOW.soilLostOz} oz.</p>
</div>
