---
// The whole page: a day in a leaf, with a 24 hour dial in the margin of each part. They are the Panel components and src/scripts/photo.
// Without a script each part shows one picture or table.
import '../../styles/photo.css';
import { dialSvg } from '../../lib/photo';
import { intro, panels } from '../../data/photo';
import PanelColours from './PanelColours.astro';
import PanelLimits from './PanelLimits.astro';
import PanelGrams from './PanelGrams.astro';
import PanelWillow from './PanelWillow.astro';
import PanelDay from './PanelDay.astro';

const tools: Record<string, typeof PanelColours> = { colours: PanelColours, limits: PanelLimits, grams: PanelGrams, willow: PanelWillow, day: PanelDay };
---

<div class="photo" data-photo>
  <section class="hours opening" aria-labelledby="photo-intro">
    <div class="rail" aria-hidden="true">
      <svg class="dial" viewBox="0 0 60 60" set:html={dialSvg(0)}></svg>
    </div>
    <div class="body">
      <p class="kicker">Midnight, 00:00</p>
      <h2 id="photo-intro">{intro.title}</h2>
      {intro.paras.map((p) => <p class="para">{p}</p>)}
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="hours" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="rail" aria-hidden="true">
            <svg class="dial" viewBox="0 0 60 60" set:html={dialSvg(p.hour)}></svg>
          </div>
          <div class="body">
            <p class="kicker">{p.kicker}</p>
            <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
            <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
            {
              p.tags && (
                <div class="tags">
                  {p.tags.map((t) => (
                    <aside class="tag">
                      <p class="tag-label">{t.label}</p>
                      <p class="tag-text">{t.text}</p>
                    </aside>
                  ))}
                </div>
              )
            }
            <Tool />
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/photo/photo';
</script>
