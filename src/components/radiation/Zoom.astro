---
// The whole zoom: a bar with the size of the picture, one round lens, and eight scenes.
// The pictures and tools are in the Scene components. The behaviour is in src/scripts/radiation.
// Without scripts this is a normal page you can scroll and read.
import '../../styles/zoom.css';
import { scenes } from '../../data/radiation';
import SceneRoom from './SceneRoom.astro';
import SceneBody from './SceneBody.astro';
import SceneTumour from './SceneTumour.astro';
import SceneCell from './SceneCell.astro';
import SceneDna from './SceneDna.astro';
import SceneRays from './SceneRays.astro';
import SceneWeeks from './SceneWeeks.astro';
import ScenePerson from './ScenePerson.astro';

const parts = [SceneRoom, SceneBody, SceneTumour, SceneCell, SceneDna, SceneRays, SceneWeeks, ScenePerson];

// The ring around the lens: small ticks every 5 degrees, bigger ones every 45
const ticks = Array.from({ length: 72 }, (_, i) => {
  const a = (i * 5 * Math.PI) / 180;
  const major = i % 9 === 0;
  const r1 = major ? 96.6 : 97.4;
  const r2 = 99.6;
  const p = (r: number) => `${(100 + Math.sin(a) * r).toFixed(1)} ${(100 - Math.cos(a) * r).toFixed(1)}`;
  return `M${p(r1)}L${p(r2)}`;
}).join('');
---

<div class="zoom" data-zoom>
  <div class="zrig" data-rig>
    <div class="zhud">
      <div class="zscale" aria-hidden="true">
        <span class="zscale-num" data-fov>4 m</span>
        <span class="zscale-lab">across the picture</span>
      </div>
      <nav class="zroute" aria-label="Scenes">
        <ol>
          {
            scenes.map((s, i) => (
              <li>
                <button type="button" data-jump={i} aria-label={`Go to scene ${i + 1}: ${s.title}`}>
                  <span class="dot"></span>
                </button>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="zbtns">
        <button class="zplain needs-js" type="button" data-plain aria-pressed="false">Plain<span class="zp-more"> view</span></button>
        <button class="snd needs-js" type="button" data-sound aria-pressed="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"></path>
            <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span class="visually-hidden" data-sound-label>Sound on</span>
        </button>
      </div>
    </div>

    <p class="visually-hidden" role="status" aria-live="polite" data-announce></p>

    <div class="zring" data-ring aria-hidden="true">
      <svg viewBox="0 0 200 200" focusable="false">
        <circle cx="100" cy="100" r="95" fill="none" stroke="#1f9d95" stroke-width="3.4"></circle>
        <path d={ticks} fill="none" stroke="#fff3dc" stroke-width="1.5" stroke-linecap="round" opacity="0.7"></path>
      </svg>
    </div>
    <div class="zruler" aria-hidden="true"><span class="zbar" data-bar></span><span data-bar-label>1 m</span></div>
    <p class="zhint" aria-hidden="true">Scroll to zoom in</p>

    {parts.map((Part, i) => <Part scene={scenes[i]} next={scenes[i + 1]} />)}
  </div>
</div>

<script>
  import '../../scripts/radiation/zoom';
</script>
