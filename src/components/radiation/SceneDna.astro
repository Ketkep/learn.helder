---
// Scene 5: a piece of DNA. Radiation breaks the helix in places. The cell repairs the breaks,
// a healthy cell faster than a tumour cell. Too many breaks at once and the cell dies.
import Scene from './Scene.astro';
import type { Radiation, Scene as SceneData } from '../../data/radiation';
import { fill } from '../../lib/text';

interface Props {
  scene: SceneData;
  copy: Radiation;
}
const { scene, copy } = Astro.props;
const t = copy.dna;
---

<Scene scene={scene} copy={copy} bg="#0f1d2e" jsArt label={t.art}>
  <canvas slot="art" data-dna width="800" height="800"></canvas>

  <div class="controls" role="group" aria-label={t.kindGroup}>
    <button type="button" class="btn" aria-pressed="true" data-cell-type="healthy">{t.healthy}</button>
    <button type="button" class="btn" aria-pressed="false" data-cell-type="tumour">{t.tumour}</button>
  </div>
  <div class="controls">
    <button type="button" class="btn fill" data-radiate>{t.radiate}</button>
    <button type="button" class="btn" data-dna-reset>{t.reset}</button>
  </div>
  <div class="meter">
    <div class="meter-top"><span>{t.breaks}</span><span data-breaks-text>{fill(t.breaksOf, { n: 0, limit: 8 })}</span></div>
    <div class="meter-bar"><div class="meter-fill" data-breaks-bar></div></div>
  </div>
  <p class="status" role="status" data-dna-status></p>
</Scene>
