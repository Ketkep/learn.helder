---
// Scene 8: the person. Pick the body area that is treated and see which complaints are common
// there. The last button hangs streamers up, like some teams do for the last session.
import Scene from './Scene.astro';
import type { Scene as SceneData } from '../../data/radiation';
import { areas, everyone } from '../../data/radiation';

interface Props {
  scene: SceneData;
  next?: SceneData;
}
const { scene, next } = Astro.props;

const streamers = [
  { d: 'M60 70Q220 140 400 90T740 70', c: '#e4501a' },
  { d: 'M90 40Q250 110 400 62T710 40', c: '#f2b705' },
  { d: 'M40 100Q200 170 400 116T760 100', c: '#17706b' },
  { d: 'M120 20Q260 90 400 40T680 20', c: '#d65a8e' },
];
const confetti = [
  [150, 220, '#e4501a'], [250, 300, '#f2b705'], [610, 260, '#17706b'], [560, 340, '#d65a8e'], [190, 400, '#17706b'],
  [660, 430, '#f2b705'], [300, 180, '#d65a8e'], [520, 200, '#e4501a'], [120, 520, '#f2b705'], [690, 560, '#e4501a'],
] as const;
---

<Scene scene={scene} next={next} bg="#dcebe8" keepWords label="A person standing in a light room. Three round areas are marked on the body: the head and neck, the chest, and the belly and pelvis. One of them is lit up to show where the treatment is.">
  <svg slot="art" class="pe" data-person-art data-area="head" data-last="off" viewBox="0 0 800 800">
    <rect width="800" height="800" fill="#e6f1ef"></rect>
    <rect y="700" width="800" height="100" fill="#c4d8d4"></rect>
    <path d="M0 700H800" stroke="#0e1b1d" stroke-width="4"></path>
    <ellipse cx="400" cy="706" rx="130" ry="12" fill="#0e1b1d" opacity="0.15"></ellipse>

    <!-- legs and shoes -->
    <rect x="350" y="540" width="42" height="150" rx="14" fill="#e8b98a" stroke="#0e1b1d" stroke-width="4"></rect>
    <rect x="408" y="540" width="42" height="150" rx="14" fill="#e8b98a" stroke="#0e1b1d" stroke-width="4"></rect>
    <ellipse cx="364" cy="694" rx="34" ry="14" fill="#fff" stroke="#0e1b1d" stroke-width="4"></ellipse>
    <ellipse cx="436" cy="694" rx="34" ry="14" fill="#fff" stroke="#0e1b1d" stroke-width="4"></ellipse>
    <!-- gown -->
    <path d="M326 276Q400 252 474 276L490 570H310Z" fill="#a9cfe4" stroke="#0e1b1d" stroke-width="4" stroke-linejoin="round"></path>
    <path d="M400 262V570" stroke="#7fb0cc" stroke-width="4"></path>
    <!-- arms -->
    <path d="M326 282Q292 300 288 400L282 478" fill="none" stroke="#0e1b1d" stroke-width="46" stroke-linecap="round"></path>
    <path d="M326 282Q292 300 288 400L282 478" fill="none" stroke="#a9cfe4" stroke-width="38" stroke-linecap="round"></path>
    <path d="M474 282Q508 300 512 400L518 478" fill="none" stroke="#0e1b1d" stroke-width="46" stroke-linecap="round"></path>
    <path d="M474 282Q508 300 512 400L518 478" fill="none" stroke="#a9cfe4" stroke-width="38" stroke-linecap="round"></path>
    <circle cx="281" cy="500" r="22" fill="#e8b98a" stroke="#0e1b1d" stroke-width="4"></circle>
    <circle cx="519" cy="500" r="22" fill="#e8b98a" stroke="#0e1b1d" stroke-width="4"></circle>
    <!-- neck and head -->
    <rect x="380" y="236" width="40" height="44" rx="10" fill="#e8b98a" stroke="#0e1b1d" stroke-width="4"></rect>
    <circle cx="400" cy="190" r="52" fill="#e8b98a" stroke="#0e1b1d" stroke-width="4"></circle>
    <path d="M350 180Q352 126 404 130Q452 130 452 182Q430 156 400 158Q372 156 350 180Z" fill="#6b4a32" stroke="#0e1b1d" stroke-width="4" stroke-linejoin="round"></path>
    <circle cx="382" cy="196" r="4.5" fill="#0e1b1d"></circle>
    <circle cx="418" cy="196" r="4.5" fill="#0e1b1d"></circle>
    <path d="M384 218Q400 230 416 218" fill="none" stroke="#0e1b1d" stroke-width="4" stroke-linecap="round"></path>

    <!-- the three areas: the chosen one glows -->
    <ellipse class="pe-spot pe-spot-head" data-spot="head" cx="400" cy="226" rx="86" ry="78"></ellipse>
    <ellipse class="pe-spot pe-spot-chest" data-spot="chest" cx="400" cy="350" rx="94" ry="64"></ellipse>
    <ellipse class="pe-spot pe-spot-belly" data-spot="belly" cx="400" cy="478" rx="98" ry="74"></ellipse>

    <!-- streamers, for the last session -->
    <g class="pe-fun">
      {streamers.map((s) => <path d={s.d} fill="none" stroke={s.c} stroke-width="10" stroke-linecap="round" stroke-dasharray="26 8"></path>)}
      {confetti.map(([x, y, c]) => <rect x={x} y={y} width="14" height="14" rx="3" fill={c} transform={`rotate(${(x * 7) % 90} ${x} ${y})`}></rect>)}
    </g>
  </svg>

  <div class="controls" role="group" aria-label="Treated area">
    {areas.map((a, i) => <button type="button" class="btn needs-js" aria-pressed={i === 0 ? 'true' : 'false'} data-area-btn={a.id}>{a.label}</button>)}
  </div>
  <div class="pe-areas">
    {
      areas.map((a) => (
        <p class="pe-area" data-area-info={a.id}>
          <strong>{a.label}.</strong> {a.complaints}
        </p>
      ))
    }
  </div>
  <p class="pe-all"><strong>Everyone.</strong> {everyone}</p>
  <div class="controls">
    <button type="button" class="btn fill needs-js" aria-pressed="false" data-last-btn>The last session</button>
  </div>
  <p class="status needs-js" role="status" data-pe-status></p>
</Scene>

<style is:global>
  .pe .pe-spot {
    fill: rgb(23 112 107 / 0);
    stroke: #17706b;
    stroke-width: 4;
    stroke-dasharray: 8 8;
    opacity: 0.55;
    cursor: pointer;
  }

  .pe[data-area='head'] .pe-spot-head,
  .pe[data-area='chest'] .pe-spot-chest,
  .pe[data-area='belly'] .pe-spot-belly {
    fill: rgb(23 112 107 / 0.3);
    stroke: #e4501a;
    stroke-dasharray: none;
    opacity: 1;
  }

  .pe .pe-fun {
    display: none;
  }

  .pe[data-last='on'] .pe-fun {
    display: inline;
  }

  .js .pe-areas {
    display: grid;
  }

  .js .pe-area {
    grid-area: 1 / 1;
  }

  .pe-area[data-off] {
    visibility: hidden;
  }

  .pe-areas {
    display: grid;
    gap: 0.5rem;
  }

  .pe-area,
  .pe-all {
    font-size: 0.93rem;
    line-height: 1.42;
  }
</style>
