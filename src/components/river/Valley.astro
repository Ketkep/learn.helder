---
// The whole page: a river drawn down the page from the spring to the sea. The stops are the Panel components and src/scripts/river.
// Without a script each stop shows one picture or table.
import '../../styles/river.css';
import { intro, panels } from '../../data/river';
import PanelProfile from './PanelProfile.astro';
import PanelGrains from './PanelGrains.astro';
import PanelBend from './PanelBend.astro';
import PanelDelta from './PanelDelta.astro';

const tools: Record<string, typeof PanelProfile> = { profile: PanelProfile, grains: PanelGrains, bend: PanelBend, delta: PanelDelta };
const widths = [5, 10, 17, 28];
const wiggle = [
  'M30,0 C14,40 46,80 30,120 S12,170 30,200',
  'M30,0 C48,50 12,90 30,130 S50,180 30,200',
  'M30,0 C10,50 50,100 30,140 S8,180 30,200',
  'M30,0 C50,40 10,80 30,120 S30,170 30,200',
];
---

<div class="river" data-river>
  <section class="opening" aria-labelledby="river-intro">
    <div class="wrap">
      <p class="kicker">Downstream</p>
      <h2 id="river-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  {
    panels.map((p, i) => {
      const Tool = tools[p.id];
      return (
        <section class="stop" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <svg class="ribbon" viewBox="0 0 60 200" preserveAspectRatio="none" aria-hidden="true">
            <path d={wiggle[i]} fill="none" stroke-width={widths[i]} vector-effect="non-scaling-stroke"></path>
          </svg>
          <div class="stop-body">
            <p class="kicker">{p.kicker}</p>
            <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
            <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
            <Tool />
            {
              p.tags && (
                <div class="tags">
                  {p.tags.map((t) => (
                    <aside class="tag">
                      <p class="tag-label">{t.label}</p>
                      <p class="tag-text">{t.text}</p>
                    </aside>
                  ))}
                </div>
              )
            }
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/river/river';
</script>
