---
// Floor 3: counting the fractions. Without a script the table shows the first places of the list.
import { COUNTED, cells, fractionsSvg } from '../../lib/hotel';
const first = cells().filter((c) => c.order > 0).slice(0, 8);
---

<div class="tool" data-frac-tool>
  <svg class="plate" viewBox="0 0 250 220" role="img" aria-label="A staircase of fractions, with p along the top and q down the side, and a line that walks along the rows and skips the fractions that are not in lowest terms." data-frac-svg>
    <rect class="stage" x="1" y="1" width="248" height="218" rx="8"></rect>
    <g set:html={fractionsSvg(COUNTED)} data-frac-g></g>
  </svg>
  <table class="times">
    <caption class="sr-only">The first places of the list of fractions</caption>
    <thead><tr><th scope="col">Place</th><th scope="col">Fraction</th></tr></thead>
    <tbody>{first.map((c) => <tr><th scope="row">{c.order}</th><td>{c.p}/{c.q}</td></tr>)}</tbody>
  </table>
  <div class="controls needs-js">
    <label class="field"><span>Walk to place <output data-frac-out>{COUNTED}</output></span><input class="range" type="range" min="0" max={COUNTED} step="1" value={COUNTED} data-frac-range aria-label="How far along the list to walk" /></label>
  </div>
  <div class="controls needs-js">
    <label class="field"><span>Top</span><input class="text" type="number" min="1" max="60" step="1" value="3" data-frac-p aria-label="Top of the fraction, 1 to 60" /></label>
    <label class="field"><span>Bottom</span><input class="text" type="number" min="1" max="60" step="1" value="7" data-frac-q aria-label="Bottom of the fraction, 1 to 60" /></label>
  </div>
  <p class="status" aria-live="polite" data-frac-status>Every fraction in lowest terms gets one place. The first is 1/1, the second is 1/2 and the third is 2/1.</p>
</div>
