---
// Site header. It sits on the same color as the top of the page (--band),
// so header and hero read as one block.
import { siteText } from '../lib/siteText';
import type { Lang } from '../lib/text';

interface Props {
  lang?: Lang;
  /** The part of the site this page belongs to. */
  current?: 'today' | 'archive' | 'library';
}
const { lang = 'en', current } = Astro.props;
const words = siteText[lang];
const links = [
  { id: 'today', href: '/', text: words.navToday },
  { id: 'archive', href: '/archive/', text: words.navArchive },
  { id: 'library', href: '/library/', text: words.navLibrary },
] as const;
---

<header class="site-header">
  <div class="wrap inner">
    <a class="wordmark" href="/" aria-label={words.homeLabel}>
      <!-- The logo is a slider: a line with a knob on it -->
      <svg class="mark" viewBox="0 0 28 24" width="28" height="24" aria-hidden="true">
        <path d="M2 12h24" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <circle cx="18" cy="12" r="6" fill="var(--accent)" stroke="currentColor" stroke-width="2" />
      </svg>
      <span>Helder Labs <span class="wordmark-light">Learn</span></span>
    </a>
    <nav aria-label={words.mainNav}>
      {links.map((l) => <a href={l.href} aria-current={current === l.id ? 'page' : undefined}>{l.text}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--band);
    color: var(--on-band);
  }

  /* On a narrow phone the menu moves under the wordmark instead of pushing the page wider */
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    min-height: 4.5rem;
    padding-block: 0.5rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-decoration: none;
  }

  .wordmark-light {
    opacity: 0.65;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem clamp(1rem, 3vw, 1.75rem);
    font-size: 0.95rem;
    font-weight: 500;
  }

  nav a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 0.15s;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    text-decoration-color: currentColor;
  }

  /* On phones "Helder Labs" is enough, so the menu fits next to it on one line */
  @media (max-width: 27rem) {
    .wordmark-light {
      display: none;
    }
  }
</style>
