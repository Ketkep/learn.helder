---
// Site header. It sits on the same color as the top of the page (--band),
// so header and hero read as one block.
---

<header class="site-header">
  <div class="wrap inner">
    <a class="wordmark" href="/" aria-label="Helder Labs Learn, home">
      <svg class="mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <circle cx="12" cy="12" r="9.5" fill="none" stroke="var(--accent)" stroke-width="2" />
        <circle cx="12" cy="12" r="3.5" fill="var(--accent)" />
      </svg>
      <span>Helder Labs <span class="wordmark-light">Learn</span></span>
    </a>
    <nav aria-label="Other Helder Labs sites">
      <a href="https://helderlabs.com">helderlabs.com</a>
      <a href="https://games.helderlabs.com">Games</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--band);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .wordmark-light {
    font-weight: 400;
    color: var(--ink-soft);
  }

  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 1.75rem);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  nav a {
    text-decoration: none;
    transition: color 0.15s;
  }

  nav a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  /* On very narrow phones the wordmark is enough, the footer has the same links */
  @media (max-width: 24rem) {
    .wordmark-light {
      display: none;
    }
  }
</style>
