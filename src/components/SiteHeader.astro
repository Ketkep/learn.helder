---
// Site header. It sits on the same color as the top of the page (--band),
// so header and hero read as one block.
---

<header class="site-header">
  <div class="wrap inner">
    <a class="wordmark" href="/" aria-label="Helder Labs Learn, home">
      <!-- The logo is a slider: a line with a knob on it -->
      <svg class="mark" viewBox="0 0 28 24" width="28" height="24" aria-hidden="true">
        <path d="M2 12h24" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <circle cx="18" cy="12" r="6" fill="var(--accent)" stroke="currentColor" stroke-width="2" />
      </svg>
      <span>Helder Labs <span class="wordmark-light">Learn</span></span>
    </a>
    <nav aria-label="Other Helder Labs sites">
      <a href="https://helderlabs.com">helderlabs.com</a>
      <a href="https://games.helderlabs.com">Games</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--band);
    color: var(--on-band);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .wordmark-light {
    opacity: 0.65;
  }

  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 1.75rem);
    font-size: 0.95rem;
    font-weight: 500;
  }

  nav a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 0.15s;
  }

  nav a:hover {
    text-decoration-color: currentColor;
  }

  /* On very narrow phones the wordmark is enough, the footer has the same links */
  @media (max-width: 24rem) {
    .wordmark-light {
      display: none;
    }
  }
</style>
