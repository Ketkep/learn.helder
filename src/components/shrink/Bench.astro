---
// The whole page: a packing table with four things to try. They are the Panel components and src/scripts/shrink.
// Without a script each part shows one table.
import '../../styles/shrink.css';
import { intro, panels } from '../../data/shrink';
import PanelRuns from './PanelRuns.astro';
import PanelRepeats from './PanelRepeats.astro';
import PanelCodes from './PanelCodes.astro';
import PanelLimits from './PanelLimits.astro';

const tools: Record<string, typeof PanelRuns> = { runs: PanelRuns, repeats: PanelRepeats, codes: PanelCodes, limits: PanelLimits };
---

<div class="shrink" data-shrink>
  <section class="panel opening" aria-labelledby="shrink-intro">
    <div class="panel-inner">
      <div class="words">
        <p class="kicker">On the table</p>
        <h2 id="shrink-intro">{intro.title}</h2>
        {intro.paras.map((p) => <p class="para">{p}</p>)}
      </div>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="panel" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="panel-inner">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/shrink/shrink';
</script>
