---
// The whole page: a night sky atlas with four plates. They are the Panel components and src/scripts/plx.
// Without a script each plate shows one picture or table.
import '../../styles/plx.css';
import { intro, panels } from '../../data/plx';
import PanelShift from './PanelShift.astro';
import PanelAngle from './PanelAngle.astro';
import PanelSmall from './PanelSmall.astro';
import PanelOld from './PanelOld.astro';

const tools: Record<string, typeof PanelShift> = { shift: PanelShift, angle: PanelAngle, small: PanelSmall, old: PanelOld };
---

<div class="plx" data-plx>
  <section class="opening" aria-labelledby="plx-intro">
    <div class="wrap">
      <p class="kicker">A sky atlas</p>
      <h2 id="plx-intro">{intro.title}</h2>
      <div class="intro-paras">{intro.paras.map((p) => <p class="para">{p}</p>)}</div>
      <button class="snd needs-js" type="button" data-sound aria-pressed="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15 9a4 4 0 0 1 0 6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path class="slash" d="M16 8.5l5 7M21 8.5l-5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span data-sound-label>Sound on</span>
      </button>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="plate" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="plate-inner">
            <div class="words">
              <p class="kicker"><span class="num" aria-hidden="true">{p.plate}</span>{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="frame">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/plx/plx';
</script>
