---
// Sheet 1: straighten the lines. Without a script the picture shows the finished diagram.
import { straightSvg, tidySegments } from '../../lib/transit';
const end = tidySegments(1);
const start = tidySegments(0);
---

<div class="tool" data-straight-tool>
  <svg class="plate" viewBox="0 0 300 210" role="img" aria-label="A made up railway map of three lines, redrawn with only flat, upright and 45 degree lines." data-straight-svg>
    <rect class="stage" x="1" y="1" width="298" height="208" rx="8"></rect>
    <g set:html={straightSvg(1)} data-straight-g></g>
  </svg>
  <table class="times">
    <caption class="sr-only">Stretches between stops that lie at a tidy angle</caption>
    <thead><tr><th scope="col">Drawing</th><th scope="col">Stretches at 0, 45 or 90 degrees</th></tr></thead>
    <tbody>
      <tr><th scope="row">Real layout</th><td>{start.tidy} of {start.total}</td></tr>
      <tr><th scope="row">Diagram</th><td>{end.tidy} of {end.total}</td></tr>
    </tbody>
  </table>
  <div class="controls needs-js">
    <label class="field"><span>Real layout to diagram <output data-straight-out>100</output>%</span><input class="range" type="range" min="0" max="100" step="1" value="100" data-straight-range aria-label="How far the map has changed from the real layout to the diagram, in per cent" /></label>
  </div>
  <p class="status" aria-live="polite" data-straight-status>In the diagram {end.tidy} of the {end.total} stretches between stops are flat, upright or at 45 degrees.</p>
</div>
