---
// The whole page: four meters. The meters are the Panel components and src/scripts/loud.
// Without a script each meter shows one picture or table.
import '../../styles/loud.css';
import { intro, panels } from '../../data/loud';
import PanelRuler from './PanelRuler.astro';
import PanelTwo from './PanelTwo.astro';
import PanelFar from './PanelFar.astro';
import PanelTime from './PanelTime.astro';

const tools: Record<string, typeof PanelRuler> = { ruler: PanelRuler, two: PanelTwo, far: PanelFar, time: PanelTime };
---

<div class="loud" data-loud>
  <section class="panel opening" aria-labelledby="loud-intro">
    <div class="panel-inner">
      <div class="words">
        <p class="kicker">Turn the dial</p>
        <h2 id="loud-intro">{intro.title}</h2>
        {intro.paras.map((p) => <p class="para">{p}</p>)}
      </div>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="panel" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="panel-inner">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/loud/loud';
</script>
