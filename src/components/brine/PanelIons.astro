---
// Pan 3: what the salt is made of. Without a script the table lists the six ions.
import { fmt, IONS, share } from '../../lib/brine';
---

<div class="tool" data-ions-tool>
  <ul class="bars" data-ions-bars>
    {IONS.map((i, k) => <li data-ion={k}><span class="bar-label">{i.name}</span><span class="track"><span class="fill" style={`width:${share(i.mgl)}%`}></span></span><span class="bar-num">{fmt(share(i.mgl), 1)}%</span></li>)}
  </ul>
  <div class="controls needs-js" role="group" aria-label="Pick an ion">
    {IONS.map((i, k) => <button type="button" class="pick" aria-pressed={k === 0 ? 'true' : 'false'} data-ions-pick={k}>{i.name}</button>)}
  </div>
  <p class="status" aria-live="polite" data-ions-status>Chloride is {fmt(share(IONS[0].mgl), 1)}% of the dissolved salts, 18,980 milligrams in a litre of seawater. Chloride and sodium together are {fmt(share(IONS[0].mgl + IONS[1].mgl), 1)}%.</p>
</div>
