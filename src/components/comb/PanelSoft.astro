---
// Cell 3: round cells squeezed into hexagons. Without a script the picture shows round cells with their gaps.
import { fill, waxSvg } from '../../lib/comb';
---

<div class="tool" data-soft-tool>
  <svg class="plate" viewBox="0 0 300 200" role="img" aria-label="Rows of round wax cells that touch each other, with small dark gaps between them." data-soft-svg>
    <g set:html={waxSvg(0)} data-soft-g></g>
  </svg>
  <div class="controls needs-js">
    <label class="field"><span>Squeeze <output data-soft-out>0</output>%</span><input class="range" type="range" min="0" max="100" step="1" value="0" data-soft-range aria-label="How far the round cells are squeezed into hexagons" /></label>
  </div>
  <p class="status" aria-live="polite" data-soft-status>Round cells leave gaps of {(100 - fill(0) * 100).toFixed(1)}% of the space. This is a toy model.</p>
</div>
