---
// Beat 4: the four valves.
import { phases, valvesSvg } from '../../lib/heart';
const p = phases[0];
---

<div class="tool" data-valves-tool>
  <svg class="strip" viewBox="0 0 300 156" role="img" aria-label="The four chambers of the heart with the four valves shown open or shut" data-valves-svg>
    <rect class="stage" x="2" y="2" width="296" height="152" rx="8"></rect>
    <g set:html={valvesSvg(p)} data-valves-g></g>
  </svg>
  <p class="key" aria-hidden="true"><span class="sw open-sw"></span> open <span class="sw shut-sw"></span> shut</p>
  <div class="controls needs-js" role="group" aria-label="Pick half of a beat">
    {phases.map((x, i) => <button type="button" class="pick" aria-pressed={i === 0 ? 'true' : 'false'} data-valves-pick={x.id}>{x.name}</button>)}
  </div>
  <p class="status" aria-live="polite" data-valves-status>{p.name}: {p.text}</p>
</div>
