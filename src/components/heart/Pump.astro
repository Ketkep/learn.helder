---
// The whole page: a flat heart with four things to try. They are the Panel components and src/scripts/heart.
// Without a script each part shows one picture.
import '../../styles/heart.css';
import { intro, panels } from '../../data/heart';
import PanelRoute from './PanelRoute.astro';
import PanelLitres from './PanelLitres.astro';
import PanelLife from './PanelLife.astro';
import PanelValves from './PanelValves.astro';

const tools: Record<string, typeof PanelRoute> = { route: PanelRoute, litres: PanelLitres, life: PanelLife, valves: PanelValves };
---

<div class="heart" data-heart>
  <section class="panel opening" aria-labelledby="heart-intro">
    <div class="panel-inner">
      <div class="words">
        <p class="kicker">Listen in</p>
        <h2 id="heart-intro">{intro.title}</h2>
        {intro.paras.map((p) => <p class="para">{p}</p>)}
      </div>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="panel" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="panel-inner">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/heart/heart';
</script>
