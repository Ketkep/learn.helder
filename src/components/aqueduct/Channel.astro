---
// The whole page: a hillside profile with four things to try. They are the Panel components and src/scripts/aqueduct.
// Without a script each part shows one picture.
import '../../styles/aqueduct.css';
import { intro, panels } from '../../data/aqueduct';
import PanelSlope from './PanelSlope.astro';
import PanelSiphon from './PanelSiphon.astro';
import PanelChoose from './PanelChoose.astro';
import PanelShare from './PanelShare.astro';

const tools: Record<string, typeof PanelSlope> = { slope: PanelSlope, siphon: PanelSiphon, choose: PanelChoose, share: PanelShare };
---

<div class="aqueduct" data-aqueduct>
  <section class="panel opening" aria-labelledby="aqueduct-intro">
    <div class="panel-inner">
      <div class="words">
        <p class="kicker">Follow the water</p>
        <h2 id="aqueduct-intro">{intro.title}</h2>
        {intro.paras.map((p) => <p class="para">{p}</p>)}
      </div>
    </div>
  </section>

  {
    panels.map((p) => {
      const Tool = tools[p.id];
      return (
        <section class="panel" id={`panel-${p.id}`} aria-labelledby={`panel-${p.id}-h`}>
          <div class="panel-inner">
            <div class="words">
              <p class="kicker">{p.kicker}</p>
              <h2 id={`panel-${p.id}-h`}>{p.title}</h2>
              <div class="paras">{p.paras.map((t) => <p class="para">{t}</p>)}</div>
              {
                p.tags && (
                  <div class="tags">
                    {p.tags.map((t) => (
                      <aside class="tag">
                        <p class="tag-label">{t.label}</p>
                        <p class="tag-text">{t.text}</p>
                      </aside>
                    ))}
                  </div>
                )
              }
            </div>
            <div class="bench">
              <Tool />
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<script>
  import '../../scripts/aqueduct/aqueduct';
</script>
