---
// Layer 3: water takes more room as ice. Without a script the picture shows a bottle 90 per cent full.
import { ICE_VOLUME, bottleSvg, fmt } from '../../lib/ice';
---

<div class="tool" data-bottle-tool>
  <svg class="plate" viewBox="0 0 300 170" role="img" aria-label="Two bottles. The first is filled with water to ninety per cent. The second shows the same water as ice, which fills it past the top." data-bottle-svg>
    <g set:html={bottleSvg(90)} data-bottle-g></g>
  </svg>
  <div class="controls needs-js">
    <label class="field"><span>Full <output data-bottle-out>90</output>%</span><input class="range" type="range" min="50" max="100" step="1" value="90" data-bottle-range aria-label="How full the bottle is with water, in per cent" /></label>
  </div>
  <p class="status" aria-live="polite" data-bottle-status>90% full of water becomes {fmt(90 * ICE_VOLUME, 1)}% of the bottle as ice, which is too much. 1000 millilitres of water make about {fmt(1000 * ICE_VOLUME)} millilitres of ice.</p>
</div>
