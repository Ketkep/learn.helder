---
// Span 4: two rafters and a tie, with a weight on top. The rafters are squeezed and the tie is stretched.
// Without a script this is the triangle with the tie in place.
---

<div class="tool" data-truss-tool>
  <div class="bp">
    <svg viewBox="0 0 800 400" role="img" aria-label="A triangle made of two sloping rafters and a bar across the bottom, with a weight on top. The rafters are orange because they are squeezed. The bottom bar is light blue because it is stretched.">
      <line class="ground" x1="60" x2="740" y1="330" y2="330" />
      <path class="tri" d="M160 306l-20 24h40zM640 306l-20 24h40z" />
      <line class="member compress" data-truss-left x1="160" y1="300" x2="400" y2="120" />
      <line class="member compress" data-truss-right x1="640" y1="300" x2="400" y2="120" />
      <line class="member tension" data-truss-tie x1="160" y1="300" x2="640" y2="300" />
      <circle class="pin" data-truss-pin-l cx="160" cy="300" r="9" />
      <circle class="pin" data-truss-pin-r cx="640" cy="300" r="9" />
      <circle class="pin" data-truss-pin-a cx="400" cy="120" r="9" />
      <g data-truss-weight transform="translate(400 66)">
        <rect class="weight" x="-28" y="-24" width="56" height="48" rx="6" />
        <text class="lab small" y="8" text-anchor="middle" data-truss-weight-text>2</text>
      </g>
      <text class="lab fail" data-truss-fail x="400" y="372" text-anchor="middle"></text>
    </svg>
  </div>
  <p class="legend"><span class="key squeeze-key"></span> squeezed <span class="key stretch-key"></span> stretched</p>
  <div class="controls needs-js">
    <label class="field">
      <span>Height <output data-truss-h-out>0.4 of the base</output></span>
      <input class="range" type="range" min="15" max="70" step="1" value="40" data-truss-h aria-label="Height of the triangle as a percentage of its base" />
    </label>
  </div>
  <div class="controls needs-js">
    <label class="field">
      <span>Weight <output data-truss-p-out>2</output></span>
      <input class="range" type="range" min="1" max="5" step="0.5" value="2" data-truss-p aria-label="Size of the weight" />
    </label>
    <button type="button" class="btn" aria-pressed="true" data-truss-switch>Bottom bar: on</button>
  </div>
  <p class="status" aria-live="polite" data-truss-status>
    Each rafter is squeezed with a force of 1.6 and the bottom bar is stretched with a force of 1.3, for a weight of 2.
  </p>
</div>
