---
// Learndle No. 1: "Closer to the Sun, colder outside". The quality example for the daily editions.
// The arc: a hook that does not add up, a guess, an experiment with two switches that each remove one
// suspected cause, the explanation (which comes back to the guess), three new situations, and the end.
// The model is in model.ts, the pictures in draw.ts, the controls in sim.ts.
import EditionLayout from '../../components/daily/EditionLayout.astro';
import Step from '../../components/daily/Step.astro';
import Question from '../../components/daily/Question.astro';
import Reveal from '../../components/daily/Reveal.astro';
import Done from '../../components/daily/Done.astro';
import type { Edition } from '../../data/editions';
import { PLACES, dayOfYear, hoursLabel, distance, noonHeight } from './model';
import { beamView, dayBar, readouts, sideView, yearChart } from './draw';
import './edition.css';

interface Props {
  edition: Edition;
}
const { edition } = Astro.props;

const start = dayOfYear(Number(edition.date.slice(5, 7)), Number(edition.date.slice(8, 10)));
const ams = PLACES[0].lat;
const first = readouts(ams, start);
const june = dayOfYear(6, 21);
const december = dayOfYear(12, 21);

const steps = [
  { id: 'hook', label: 'The question' },
  { id: 'guess', label: 'Your guess' },
  { id: 'try', label: 'Try it' },
  { id: 'why', label: 'Why' },
  { id: 'use', label: 'Use it' },
  { id: 'done', label: 'Done' },
];

const sources = [
  { label: 'NASA Space Place: What causes the seasons?', url: 'https://spaceplace.nasa.gov/seasons/en/', for: 'The seasons come from the tilt, and the north has winter when the Earth is closest to the Sun.' },
  { label: 'NASA: Earth fact sheet', url: 'https://nssdc.gsfc.nasa.gov/planetary/factsheet/earthfact.html', for: 'The tilt of 23.44°, and the closest and farthest distances: 147.1 and 152.1 million km.' },
  { label: 'NASA: Mars fact sheet', url: 'https://nssdc.gsfc.nasa.gov/planetary/factsheet/marsfact.html', for: 'Mars: a tilt of 25.19°, and distances of 206.65 to 249.26 million km.' },
  { label: 'NASA Science: Helio and you, seasons on Earth, Mars and beyond', url: 'https://science.nasa.gov/helio-and-you-seasons-on-earth-mars-and-beyond/', for: 'On Mars the southern summer is the warmer one.' },
  { label: 'Encyclopaedia Britannica: perihelion', url: 'https://www.britannica.com/science/perihelion', for: 'The closest point of 2027: 3 January, 02:33 UTC.' },
  { label: 'Space.com: Earth at perihelion', url: 'https://www.space.com/39262-earth-at-perihelion-2018.html', for: 'About 7 per cent more sunlight at the closest point, as NASA scientists put it.' },
  { label: 'Science in School: A Private Universe', url: 'https://scienceinschool.org/article/2010/privateuniverse/', for: 'The 1987 film of Harvard graduates explaining the seasons by the distance.' },
  { label: 'KNMI: January 2023 in the Netherlands', url: 'https://www.knmi.nl/nederland-nu/klimatologie/maand-en-seizoensoverzichten/2023/januari', for: 'The January average in De Bilt over 1991 to 2020: 3.6 °C.' },
  { label: 'KNMI: a wet July, normal in temperature', url: 'https://www.knmi.nl/over-het-knmi/nieuws/vrij-natte-juli-maar-qua-temperatuur-en-zonneschijn-wel-normaal', for: 'The July average in De Bilt over 1991 to 2020: 18.3 °C.' },
  { label: 'Penn State: the Earth’s tilted axis and the seasons', url: 'https://courses.ems.psu.edu/eme811/node/642', for: 'How a low Sun spreads the same light over more ground.' },
  { label: 'Penn State: available solar radiation', url: 'https://courses.ems.psu.edu/eme812/node/644', for: 'Sunlight at the average distance: about 1361 W per square metre (Kopp and Lean, 2011).' },
  { label: 'Solarwatch: sunrise and sunset in Amsterdam', url: 'https://solarwatch.app/en/sunrise-sunset/the-netherlands/amsterdam', for: 'Day lengths in Amsterdam, to check the model: 16 h 48 min on 21 June, 7 h 40 min in late December.' },
  { label: 'Wikipedia: seasonal lag', url: 'https://en.wikipedia.org/wiki/Seasonal_lag', for: 'Why the coldest weeks come after the shortest day.' },
];

const sourcesNote =
  'The pages below could not be opened directly while this edition was made, so each fact was checked through search results that quote them, in at least two places. The model was checked against the Amsterdam day lengths (16 h 48 min in June, 7 h 40 min in December) and NASA’s distances, and it matches them. It counts sunlight at the top of the air, before clouds and air take their share, so real ground gets less. It leaves out weather, hills and the bending of light by the air at sunrise. The Earth and the Sun in the pictures are not to scale. Two numbers are worked out here from NASA’s figures, not quoted: the 4,000 km and the 45 per cent.';
---

<EditionLayout edition={edition} steps={steps} sources={sources} sourcesNote={sourcesNote}>
  <!-- 1. The question -->
  <Step id="hook" index={0} label="The question" title="Closer every day, and colder every day" next="Make a guess" hint="">
    <figure class="cc-hook">
      <svg viewBox="0 0 640 260" role="img" aria-label="The Earth's orbit seen from above, drawn far too oval. In mid November the Earth is on its way to its closest point on 3 January, 147.1 million km from the Sun. It is farthest on 4 July, 152.1 million km away." xmlns="http://www.w3.org/2000/svg">
        <rect width="640" height="260" rx="12" fill="#0c1b2e"></rect>
        <ellipse cx="335" cy="140" rx="250" ry="92" fill="none" stroke="#5d7a99" stroke-width="2.5" stroke-dasharray="5 8"></ellipse>
        <circle cx="300" cy="140" r="30" fill="#ffcf5a"></circle>
        <text x="300" y="198" fill="#f3ead6" font-size="21" text-anchor="middle" font-family="system-ui, sans-serif">Sun</text>
        <circle cx="85" cy="140" r="13" fill="#3d7bb0" stroke="#f3ead6" stroke-width="2.5"></circle>
        <text x="108" y="133" fill="#f3ead6" font-size="22" font-weight="700" font-family="system-ui, sans-serif">3 Jan</text>
        <text x="108" y="160" fill="#9fb3c8" font-size="20" font-family="system-ui, sans-serif">147.1</text>
        <circle cx="585" cy="140" r="13" fill="#3d7bb0" stroke="#f3ead6" stroke-width="2.5"></circle>
        <text x="562" y="133" fill="#f3ead6" font-size="22" font-weight="700" text-anchor="end" font-family="system-ui, sans-serif">4 Jul</text>
        <text x="562" y="160" fill="#9fb3c8" font-size="20" text-anchor="end" font-family="system-ui, sans-serif">152.1</text>
        <circle cx="165" cy="73" r="13" fill="#ff7a45" stroke="#0c1b2e" stroke-width="3"></circle>
        <text x="196" y="36" fill="#f3ead6" font-size="22" font-weight="700" text-anchor="middle" font-family="system-ui, sans-serif">mid November</text>
        <path d="M151 82 C130 96 112 110 100 124" fill="none" stroke="#ff7a45" stroke-width="3" stroke-linecap="round"></path>
        <path d="M97 114 L98 126 L109 121" fill="none" stroke="#ff7a45" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <figcaption>Distances in million km from the Sun. The oval is drawn far too flat: the real orbit is nearly a circle.</figcaption>
    </figure>
    <p class="lead">In November the Earth moves a little closer to the Sun every day. On 3 January it reaches its closest point of the year, about 147.1 million km away. In early July it is at its farthest, about 152.1 million km.</p>
    <p>Yet January is the heart of winter in the Netherlands. In De Bilt it averages 3.6 °C, against 18.3 °C in July. The warmest month comes when we are 5 million km farther from the Sun.</p>
    <p>If you live south of the equator, your summer falls in January. Keep that in mind. It is a clue.</p>
    <div class="ed-aside">
      <p class="ed-aside-title">In about {edition.minutes} minutes you will be able to</p>
      <ul class="cc-goals">
        {edition.goals.map((g) => <li>{g}</li>)}
      </ul>
    </div>
  </Step>

  <!-- 2. Your guess -->
  <Step id="guess" index={1} label="Your guess" title="What makes summer warm?" needs={['answered:guess']} next="Put it to the test">
    <p>Pick the answer you believe right now. Most people pick a wrong one at first, so there is nothing to lose.</p>
    <Question
      id="guess"
      kind="predict"
      prompt="Summer days are warmer than winter days because…"
      right="angle"
      noted="Saved. Next, you can switch off each of these causes and see what is left."
      choices={[
        { id: 'distance', text: 'in summer the Earth is closer to the Sun.' },
        { id: 'near-half', text: 'in summer our half of the Earth leans towards the Sun, so it is closer to it.' },
        { id: 'angle', text: 'in summer sunlight comes in more steeply, and the days are longer.' },
      ]}
    />
  </Step>

  <!-- 3. Try it -->
  <Step
    id="try"
    index={2}
    label="Try it"
    title="Switch off the causes, one at a time"
    wide
    needs={['compared', 'distance-off', 'tilt-off', 'correct:obs']}
    todo={[
      { goal: 'compared', text: 'In Amsterdam, compare a day in June with a day in December.' },
      { goal: 'distance-off', text: 'Turn off the changing distance.' },
      { goal: 'tilt-off', text: 'Turn off the tilt.' },
    ]}
    next="See why"
    hint="Do the three things in the list, then answer the question, to go on."
  >
    <p>This is a model of the sunlight that reaches one square metre of flat ground. On the left, the Earth at noon, cut through the place you pick. Next to it, what that sunlight does on the ground. Below, a whole year. Two switches change the real Earth: one keeps it at the same distance from the Sun all year, the other stands its axis up straight.</p>

    <div class="cc-sim" data-cc-sim data-start={start}>
      <div class="cc-panels">
        <figure class="cc-panel">
          <figcaption>The Earth at noon, from the side</figcaption>
          <div class="cc-pic" data-cc-side set:html={sideView(ams, start)} />
        </figure>
        <figure class="cc-panel">
          <figcaption>The same sunlight on the ground</figcaption>
          <div class="cc-pic" data-cc-beam set:html={beamView(noonHeight(ams, start))} />
          <div class="cc-pic cc-daybar" data-cc-daybar set:html={dayBar(first.daylight)} />
          <p class="cc-daybar-label">Daylight: <span data-cc-r-daylight>{hoursLabel(first.daylight)}</span></p>
        </figure>
      </div>

      <dl class="cc-read">
        <div><dt>Day</dt><dd data-cc-r-date>{first.date}</dd></div>
        <div><dt>Distance to the Sun</dt><dd data-cc-r-distance>{distance(start).toFixed(1)} million km</dd></div>
        <div><dt>Sun at noon</dt><dd data-cc-r-height>{first.height}</dd></div>
        <div><dt>Sunlight that day</dt><dd data-cc-r-energy>{first.energy.toFixed(1)} kWh per m²</dd></div>
      </dl>

      <div class="cc-controls needs-js">
        <div class="cc-day">
          <label for="cc-day">Day of the year</label>
          <input type="range" class="ed-range" id="cc-day" min="1" max="365" step="1" value={start} data-cc-day />
          <output for="cc-day" data-cc-day-out>{first.date}</output>
        </div>
        <div class="ed-chips" role="group" aria-label="Jump to a day">
          <button type="button" class="ed-chip" data-cc-jump={start} aria-pressed="true">12 Nov</button>
          <button type="button" class="ed-chip" data-cc-jump={june} aria-pressed="false">21 Jun</button>
          <button type="button" class="ed-chip" data-cc-jump={december} aria-pressed="false">21 Dec</button>
          <button type="button" class="ed-chip" data-cc-jump={dayOfYear(1, 3)} aria-pressed="false">3 Jan, closest</button>
        </div>
        <div class="ed-chips" role="group" aria-label="Place">
          {PLACES.map((p, i) => <button type="button" class="ed-chip" data-cc-place={p.id} aria-pressed={i === 0 ? 'true' : 'false'}>{p.name}</button>)}
        </div>
      </div>

      <div class="ed-switches needs-js" role="group" aria-label="Change the real Earth">
        <button type="button" class="ed-switch" role="switch" aria-checked="true" data-cc-switch="distance">
          <span class="ed-track" aria-hidden="true"><span class="ed-knob"></span></span>
          <span class="ed-sw-text"><strong>Changing distance to the Sun</strong><span data-cc-sw-state>On, as in real life</span></span>
        </button>
        <button type="button" class="ed-switch" role="switch" aria-checked="true" data-cc-switch="tilt">
          <span class="ed-track" aria-hidden="true"><span class="ed-knob"></span></span>
          <span class="ed-sw-text"><strong>Tilt of the Earth’s axis</strong><span data-cc-sw-state>On, 23.4°</span></span>
        </button>
      </div>

      <figure class="cc-panel">
        <figcaption>Sunlight per day through the year, in <span data-cc-place-name>Amsterdam</span></figcaption>
        <div class="cc-pic cc-year-wide" data-cc-year set:html={yearChart(ams, start)} />
        <div class="cc-pic cc-year-narrow" data-cc-year-narrow set:html={yearChart(ams, start, undefined, true)} />
      </figure>
      <p class="visually-hidden" aria-live="polite" data-cc-say></p>
    </div>

    <Question
      id="obs"
      kind="check"
      prompt="Which switch makes June and December almost the same in Amsterdam?"
      choices={[
        {
          id: 'distance',
          text: 'Turning off the changing distance.',
          feedback: 'With the distance kept the same, 21 June still gets about 11.9 kWh per square metre and 21 December about 1.6. The gap even grows a little, because in real life the Earth is closest in the northern winter.',
        },
        {
          id: 'tilt',
          text: 'Turning off the tilt.',
          correct: true,
          feedback: 'With the axis straight up, every day in Amsterdam gets between about 6.2 and 6.6 kWh per square metre. The summer and the winter are gone. The small wave that is left comes from the distance, and it peaks in January.',
        },
        {
          id: 'both',
          text: 'Both, about the same amount.',
          feedback: 'Try them one at a time and watch the yellow line. One switch hardly moves it. The other flattens it.',
        },
      ]}
    />
  </Step>

  <!-- 4. Why -->
  <Step id="why" index={3} label="Why" title="One tilt, two effects" next="Use it" hint="">
    <p class="lead">The Earth’s axis is tilted by 23.4 degrees, and it points the same way in space all year. So for half of the year the north leans towards the Sun, and for the other half it leans away. The lean does two things.</p>

    <div class="cc-compare">
      <figure>
        <div class="cc-pic" set:html={beamView(noonHeight(ams, june))} />
        <figcaption><strong>21 June, noon, Amsterdam.</strong> The Sun is 61° up. A square metre of sunlight lands on 1.1 m² of ground.</figcaption>
      </figure>
      <figure>
        <div class="cc-pic" set:html={beamView(noonHeight(ams, december))} />
        <figcaption><strong>21 December, noon.</strong> The Sun is 14° up. The same sunlight is spread over 4.1 m².</figcaption>
      </figure>
    </div>

    <h3 class="cc-h3">Steep light is strong light</h3>
    <p>A beam of sunlight carries a fixed amount of energy. When the Sun is high, the beam lands on a small patch, and every square metre gets a lot. When the Sun is low, the same beam is smeared over a patch almost four times as large, so every square metre gets about a quarter.</p>

    <h3 class="cc-h3">Long days add up</h3>
    <p>In Amsterdam the longest day lasts about 16 hours 48 minutes, and the shortest about 7 hours 40 minutes. Together with the angle, that gives about seven times more sunlight on a square metre on 21 June than on 21 December: 11.5 against 1.7 kWh in the model.</p>

    <h3 class="cc-h3">And the distance?</h3>
    <p>The orbit is nearly a circle. Between its closest and farthest points the distance changes by about 3 per cent, so the sunlight changes by about 7 per cent. That is real, but small. And in the north it peaks in January, the wrong month for summer.</p>

    <Reveal
      question="guess"
      cases={[
        {
          when: ['distance'],
          label: 'If you picked the distance',
          html: '<strong>You picked the distance.</strong> You are in good company: in a well-known 1987 film, <em>A Private Universe</em>, students at their Harvard graduation gave the same answer. Two facts rule it out. The Earth is closest in January. And the north and the south have opposite seasons, while they are the same distance from the Sun.',
        },
        {
          when: ['near-half'],
          label: 'If you picked the leaning half',
          html: '<strong>You picked the leaning half being closer.</strong> It is closer, but by very little. At noon in June, Amsterdam is about 4,000 km nearer to the Sun than at noon in December. The Sun is about 150 million km away, so that is less than 0.003 per cent. What the lean really changes is the angle of the light and the length of the day.',
        },
        {
          when: ['angle'],
          label: 'If you picked the angle and the length of the day',
          html: '<strong>You picked the angle and the length of the day.</strong> That is right. Now you have also seen how big it is: about seven times more sunlight on a June day than on a December day in Amsterdam.',
        },
      ]}
    />

    <div class="ed-aside">
      <p class="ed-aside-title">Then why is January colder than December?</p>
      <p>The shortest day is around 21 December, but the coldest weeks come later. Land and sea store the summer’s heat and give it back slowly, so it takes weeks of weak sunlight before the temperature bottoms out. This delay is called the seasonal lag.</p>
    </div>
  </Step>

  <!-- 5. Use it -->
  <Step id="use" index={4} label="Use it" title="Three new situations" needs={['correct:sun', 'correct:straight', 'correct:mars']} next="Finish" hint="Find the right answer to all three questions to finish.">
    <p>Use what you found out. A wrong answer explains itself, and you can try again. Only your first try counts for your result.</p>

    <Question
      id="sun"
      kind="apply"
      prompt="It is 21 December at noon. Where does the Sun stand highest in the sky?"
      choices={[
        { id: 'amsterdam', text: 'In Amsterdam.', feedback: 'In December the north leans away from the Sun. At noon in Amsterdam the Sun is only about 14° up, its lowest of the year.' },
        { id: 'quito', text: 'In Quito, on the equator.', feedback: 'Close, but in December the Sun is not overhead at the equator. On 21 December it is overhead at about 23.4° south, so Quito sees it about 67° up.' },
        { id: 'sydney', text: 'In Sydney.', correct: true, feedback: 'In December the south leans towards the Sun. The Sun is overhead at 23.4° south, not far from Sydney at 33.9° south, so it stands about 80° up there. That is why December is summer in Sydney.' },
      ]}
    />

    <Question
      id="straight"
      kind="apply"
      prompt="Imagine the Earth’s axis stood straight up, and the orbit stayed as it is. What would a year in Amsterdam be like?"
      choices={[
        { id: 'same', text: 'Much like now, with warm summers and cold winters.', feedback: 'Without the tilt, the noon Sun would reach the same height every day, and every day would last about 12 hours. That is what flattened the year in the experiment.' },
        { id: 'flat', text: 'Much the same all year, with slightly more sunlight in January.', correct: true, feedback: 'In the model every day would bring about 6.2 to 6.6 kWh per square metre. The small swing that is left comes from the distance, so it peaks in early January, when the Earth is closest.' },
        { id: 'summer', text: 'A summer that lasts all year.', feedback: 'Amsterdam would get the sunlight of a spring day all year: about half of what a real June day brings. No summer, and no winter either.' },
      ]}
    />

    <Question
      id="mars"
      kind="apply"
      prompt="Mars is tilted by about 25°, close to the Earth’s 23.4°. But its distance from the Sun swings much more, from about 207 to about 249 million km. What would you expect?"
      choices={[
        { id: 'none', text: 'No seasons: Mars is too far from the Sun for them.', feedback: 'The distance from the Sun decides how cold a planet is overall, not whether it has seasons. Seasons come from the tilt, and Mars has one.' },
        { id: 'both', text: 'Seasons from the tilt, with the summers of one half stronger, because of the distance.', correct: true, feedback: 'The tilt gives Mars seasons, as it does the Earth. On top of that, at its closest Mars gets about 45 per cent more sunlight than at its farthest (worked out from NASA’s distances). The southern summer falls near the closest point, so it is the warmer one.' },
        { id: 'distance', text: 'Seasons from the distance only, since the tilt is small.', feedback: 'A tilt of 25° is not small: it is a little more than the Earth’s, and it gives Mars seasons. The distance comes on top of that.' },
      ]}
    />
  </Step>

  <!-- 6. Done -->
  <Done
    index={5}
    discovery="The seasons come from the tilt of the Earth’s axis, not from its distance to the Sun. The tilt makes summer sunlight arrive steeply and for long days, and winter sunlight low and brief."
    takeaway="The same two effects explain why the tropics stay warm all year and why the poles get months of night: it comes down to the angle of the light and the length of the day."
    deeper={edition.basedOn}
  />
</EditionLayout>

<script>
  import './sim';
</script>
