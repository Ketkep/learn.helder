---
// Homepage: hero, category filter and the shelf of covers. The shelf is built from
// src/data/topics.ts, so nothing here changes when a topic is added.
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/TopicCard.astro';
import Lamp from '../components/Lamp.astro';
import { getVisibleTopics, getCategories, getTopicNumber } from '../data/topics';

const topics = getVisibleTopics();
const categories = getCategories();
---

<BaseLayout
  title="Helder Labs Learn: interactive explainers"
  description="Interactive explainers from Helder Labs, one topic at a time."
>
  <section class="hero">
    <div class="wrap hero-inner">
      <h1 class="hero-title">
        <span class="line">Helder Labs</span>
        <span class="line">
          <!-- The orange marker circle draws itself around the word -->
          <span class="circled">Learn<svg class="doodle" viewBox="0 0 240 110" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M34 30C74 6 172 4 214 28C242 44 228 88 168 99C112 110 40 100 14 74C-2 54 14 28 54 14C74 8 98 6 120 8" /></svg></span>
        </span>
      </h1>

      <p class="lede">Interactive explainers, one topic at a time.</p>

      <Lamp />
    </div>
  </section>

  <section class="topics wrap" aria-labelledby="topics-heading">
    <h2 id="topics-heading" class="visually-hidden">Topics</h2>

    {
      categories.length > 1 && (
        <div class="filter" role="group" aria-label="Filter topics by category" data-filter hidden>
          <span class="filter-label" aria-hidden="true">show:</span>
          <button type="button" data-category="all" aria-pressed="true">All</button>
          {categories.map((c) => (
            <button type="button" data-category={c} aria-pressed="false">
              {c}
            </button>
          ))}
        </div>
      )
    }
    <p class="visually-hidden" role="status" data-filter-status></p>

    {
      topics.length > 0 ? (
        <div class="grid">
          {topics.map((t) => (
            <TopicCard topic={t} number={getTopicNumber(t.slug)} />
          ))}
        </div>
      ) : (
        <p class="empty">The first explainers are on their way.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    /* Keeps the lamp's long wire and its cone of light inside the hero */
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    padding-block: clamp(1rem, 3vw, 2rem) clamp(1.75rem, 4vw, 3rem);
  }

  /* The lamp hangs at the top right. On phones it gets a row of its own above the title. */
  @media (max-width: 52rem) {
    .hero-inner {
      padding-top: 6.5rem;
    }
  }

  .hero-title,
  .lede {
    position: relative;
    z-index: 1; /* above the lamp's light */
  }

  .hero-title {
    font-size: clamp(3.4rem, 11vw, 7.25rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }

  .hero-title .line {
    display: block;
  }

  .circled {
    position: relative;
    display: inline-block;
  }

  .doodle {
    position: absolute;
    top: -0.14em;
    left: -0.26em;
    width: calc(100% + 0.52em);
    height: calc(100% + 0.3em);
    overflow: visible;
    pointer-events: none;
  }

  .doodle path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* A dash as long as the whole path, then a gap: moving the offset draws the line.
       The gap also stops the round pen tip from showing as a dot before it starts. */
    stroke-dasharray: 1 2;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.seen)) .doodle path {
      animation: draw 1s cubic-bezier(0.5, 0.1, 0.3, 1) 0.8s both;
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  .lede {
    max-width: 30rem;
    margin-top: 1.25rem;
    text-wrap: balance;
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.6rem);
    font-weight: 500;
    line-height: 1.3;
  }

  .topics {
    padding-top: clamp(0.5rem, 2vw, 1rem);
  }

  /* The filter looks like stickers stuck on the wall, each a little crooked */
  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.7rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .filter-label {
    margin-right: 0.3rem;
    color: var(--accent-text);
    font-family: var(--font-hand);
    font-size: 1.7rem;
    line-height: 1;
    rotate: -4deg;
  }

  .filter button {
    padding: 0.3rem 1rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-weight: 600;
    cursor: pointer;
    transition:
      rotate 0.2s,
      background-color 0.15s,
      color 0.15s;
  }

  .filter button:nth-of-type(odd) {
    rotate: -1.4deg;
  }

  .filter button:nth-of-type(even) {
    rotate: 1.1deg;
  }

  .filter button:hover {
    rotate: 0deg;
    background: color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .filter button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  /* The shelf: 1 cover per row on phones, 2 on tablets, 3 on desktop */
  .grid {
    --gap: clamp(1.75rem, 4vw, 2.75rem);

    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: clamp(2.5rem, 5vw, 3.5rem) var(--gap);
  }

  .empty {
    padding-block: 3rem;
    font-size: 1.25rem;
  }
</style>

<script>
  // The lamp (pull it to switch between light and dark) lives in its own file.
  import '../scripts/lamp';

  // Category filter: shows or hides covers by their data-category.
  // Without JavaScript the buttons stay hidden and every cover stays visible.
  const bar = document.querySelector<HTMLElement>('[data-filter]');

  if (bar) {
    const buttons = bar.querySelectorAll<HTMLButtonElement>('button[data-category]');
    const cards = document.querySelectorAll<HTMLElement>('[data-card]');
    const status = document.querySelector<HTMLElement>('[data-filter-status]');

    bar.hidden = false;

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const chosen = button.dataset.category;
        let shown = 0;

        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));

        cards.forEach((card) => {
          const match = chosen === 'all' || card.dataset.category === chosen;
          card.hidden = !match;
          if (match) shown++;
        });

        if (status) {
          status.textContent = `Showing ${shown} of ${cards.length} topics`;
        }
      });
    });
  }
</script>
