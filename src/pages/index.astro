---
// Homepage: hero, category filter and the topic grid. The grid is built from
// src/data/topics.ts, so nothing here changes when a topic is added.
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/TopicCard.astro';
import { getVisibleTopics, getCategories, getTopicNumber } from '../data/topics';

const topics = getVisibleTopics();
const categories = getCategories();
---

<BaseLayout
  title="Helder Labs Learn: interactive explainers"
  description="Interactive explainers from Helder Labs. Learn things by playing with them."
  band="#ffd43b"
>
  <section class="hero">
    <div class="wrap hero-inner">
      <h1 class="hero-title">
        <span>Helder Labs</span>
        <span class="learn">Learn</span>
      </h1>
      <p class="lede">
        <span>Interactive explainers.</span>
        <span>Learn things by playing with them.</span>
      </p>
    </div>

    <!-- One segment per topic, in the topic's own color -->
    {
      topics.length > 0 && (
        <div class="strip" aria-hidden="true">
          {topics.map((t) => (
            <span style={`background: ${t.accent};`} />
          ))}
        </div>
      )
    }
  </section>

  <section class="topics wrap" aria-labelledby="topics-heading">
    <h2 id="topics-heading" class="visually-hidden">Topics</h2>

    {
      categories.length > 1 && (
        <div class="filter" role="group" aria-label="Filter topics by category" data-filter hidden>
          <button type="button" data-category="all" aria-pressed="true">All</button>
          {categories.map((c) => (
            <button type="button" data-category={c} aria-pressed="false">
              {c}
            </button>
          ))}
        </div>
      )
    }
    <p class="visually-hidden" role="status" data-filter-status></p>

    {
      topics.length > 0 ? (
        <div class="grid">
          {topics.map((t, i) => (
            <TopicCard topic={t} number={getTopicNumber(t.slug)} eager={i < 3} />
          ))}
        </div>
      ) : (
        <p class="empty">The first explainers are on their way.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    --focus: var(--on-band);
    background: var(--band);
    color: var(--on-band);
    border-bottom: var(--border) solid var(--dark-ink);
  }

  .hero-inner {
    display: grid;
    gap: 1.25rem 3rem;
    padding-block: clamp(1rem, 3vw, 2.25rem) clamp(1.75rem, 4vw, 3rem);
  }

  .hero-title {
    font-size: clamp(3.4rem, 13.5vw, 7.5rem);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.04em;
  }

  .hero-title span {
    display: block;
  }

  /* The darker vermilion keeps large text above 3:1 on the yellow */
  .learn {
    color: #c4301a;
  }

  .lede span {
    display: block;
  }

  .lede {
    max-width: 23rem;
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.4rem);
    font-weight: 600;
    line-height: 1.3;
  }

  /* Hero text on the left, one-line description pinned to the bottom right */
  @media (min-width: 52rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) 23rem;
      align-items: end;
    }

    .lede {
      padding-bottom: 0.9rem;
    }
  }

  .strip {
    display: flex;
    height: 1rem;
    border-top: var(--border) solid var(--dark-ink);
  }

  .strip span {
    flex: 1;
  }

  .strip span + span {
    border-left: var(--border) solid var(--dark-ink);
  }

  .topics {
    padding-top: clamp(1.25rem, 3vw, 2rem);
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 1.25rem;
  }

  .filter button {
    padding: 0.4rem 1.05rem;
    border: var(--border) solid var(--rule);
    border-radius: 999px;
    background: transparent;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }

  .filter button:hover {
    background: var(--sun);
    color: var(--dark-ink);
  }

  .filter button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  /* Auto-fills columns: 1 on phones, 2 on tablets, 3 on desktop */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    /* Room for the 2px the cards overlap on the right and bottom */
    padding: 0 var(--border) var(--border) 0;
  }

  .empty {
    padding-block: 3rem;
    font-size: 1.25rem;
  }
</style>

<script>
  // Category filter: shows or hides cards by their data-category.
  // Without JavaScript the buttons stay hidden and every card stays visible.
  const bar = document.querySelector<HTMLElement>('[data-filter]');

  if (bar) {
    const buttons = bar.querySelectorAll<HTMLButtonElement>('button[data-category]');
    const cards = document.querySelectorAll<HTMLElement>('[data-card]');
    const status = document.querySelector<HTMLElement>('[data-filter-status]');

    bar.hidden = false;

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const chosen = button.dataset.category;
        let shown = 0;

        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));

        cards.forEach((card) => {
          const match = chosen === 'all' || card.dataset.category === chosen;
          card.hidden = !match;
          if (match) shown++;
        });

        if (status) {
          status.textContent = `Showing ${shown} of ${cards.length} topics`;
        }
      });
    });
  }
</script>
