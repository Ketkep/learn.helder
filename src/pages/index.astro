---
// Homepage: hero, category filter and the topic grid. The grid is built from
// src/data/topics.ts, so nothing here changes when a topic is added.
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/TopicCard.astro';
import { getVisibleTopics, getCategories, getTopicNumber } from '../data/topics';

const topics = getVisibleTopics();
const categories = getCategories();
---

<BaseLayout
  title="Helder Labs Learn: interactive explainers"
  description="Interactive explainers from Helder Labs. Learn things by playing with them."
>
  <!-- Runs before the page is first painted. If the hero animation is going to play, the
       title is hidden until the animation takes over, so it never flashes in its final place. -->
  <script is:inline slot="head">
    (function () {
      var root = document.documentElement;
      root.classList.add('js');
      try {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce && !sessionStorage.getItem('hero-played')) {
          root.classList.add('intro');
          // Safety net: never leave the title hidden if the animation script fails
          setTimeout(function () {
            root.classList.remove('intro');
          }, 4000);
        }
      } catch (e) {}
    })();
  </script>

  <section class="hero" data-hero>
    <div class="wrap hero-inner">
      <h1 class="hero-title" data-title>
        <span class="plain"><span class="line">Helder Labs</span> <span class="line">Learn</span></span>
        <!-- Filled by the animation script: a moving copy of every letter -->
        <span class="letters" aria-hidden="true"></span>
      </h1>

      <p class="lede">
        <span>Interactive explainers.</span>
        <span>Learn things by playing with them.</span>
      </p>

      <!-- "Helder" means clear. The knob tidies up everything it rolls over. Needs JavaScript. -->
      <div class="ruler-block">
        <div class="ruler" data-ruler>
          <canvas aria-hidden="true"></canvas>
          <input id="clarity" type="range" min="0" max="100" step="1" value="100" aria-valuetext="100 percent clear" />
        </div>
        <div class="ruler-caption">
          <label for="clarity">Drag to clear things up</label>
          <output data-ruler-value aria-hidden="true">100% clear</output>
        </div>
      </div>
    </div>
  </section>

  <section class="topics wrap" aria-labelledby="topics-heading">
    <h2 id="topics-heading" class="visually-hidden">Topics</h2>

    {
      categories.length > 1 && (
        <div class="filter" role="group" aria-label="Filter topics by category" data-filter hidden>
          <button type="button" data-category="all" aria-pressed="true">All</button>
          {categories.map((c) => (
            <button type="button" data-category={c} aria-pressed="false">
              {c}
            </button>
          ))}
          <span class="knob" aria-hidden="true" />
        </div>
      )
    }
    <p class="visually-hidden" role="status" data-filter-status></p>

    {
      topics.length > 0 ? (
        <div class="grid">
          {topics.map((t) => (
            <TopicCard topic={t} number={getTopicNumber(t.slug)} />
          ))}
        </div>
      ) : (
        <p class="empty">The first explainers are on their way.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero-inner {
    display: grid;
    gap: 1.5rem 3rem;
    padding-block: clamp(1rem, 3vw, 2rem) clamp(1.5rem, 4vw, 2.5rem);
  }

  .hero-title {
    position: relative;
    font-size: clamp(3.5rem, 11.5vw, 7.5rem);
    line-height: 0.96;
    letter-spacing: -0.02em;
  }

  .hero-title .line {
    display: block;
  }

  /* The moving copy of the letters sits exactly on top of the real title.
     While the animation runs, the copy is shown and the real title is hidden. */
  .letters {
    position: absolute;
    inset: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .letters :global(.ltr) {
    position: absolute;
    display: block;
    white-space: pre;
    transform-origin: 50% 60%;
  }

  .hero.is-animating .letters {
    visibility: visible;
  }

  /* Hidden with opacity, not visibility, so screen readers can still read the title */
  .hero.is-animating .plain,
  :global(.intro) .plain {
    opacity: 0;
  }

  .lede {
    max-width: 22rem;
    color: var(--ink-soft);
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.3rem);
    line-height: 1.4;
  }

  .lede span {
    display: block;
  }

  /* The ruler needs JavaScript, so it only takes up room when JavaScript is on */
  .ruler-block {
    display: none;
    grid-column: 1 / -1;
  }

  :global(.js) .ruler-block {
    display: block;
  }

  .ruler {
    position: relative;
    height: 5.25rem;
    cursor: grab;
  }

  .ruler:active {
    cursor: grabbing;
  }

  .ruler canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* An invisible slider on top of the drawing gives mouse, touch and keyboard for free */
  .ruler input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: inherit;
    touch-action: pan-y;
    -webkit-appearance: none;
    appearance: none;
  }

  /* The thumb is as wide as the knob, so the invisible slider and the drawn knob line up */
  .ruler input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 30px;
    height: 60px;
  }

  .ruler input::-moz-range-thumb {
    width: 30px;
    height: 60px;
    border: 0;
  }

  .ruler:has(input:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
    border-radius: 8px;
  }

  .ruler-caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.4rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .ruler-caption output {
    font-variant-numeric: tabular-nums;
  }

  /* Title on the left, the one-line description pinned to its bottom right, the ruler below */
  @media (min-width: 52rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: end;
    }

    .lede {
      padding-bottom: 0.4rem;
    }
  }

  .topics {
    padding-top: 0;
  }

  /* The filter is a slider too: a track with a knob under the chosen tab */
  .filter {
    position: relative;
    display: flex;
    gap: 1.75rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.25rem);
    padding-bottom: 1.1rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filter::before {
    content: '';
    position: absolute;
    right: 0;
    bottom: 7px;
    left: 0;
    height: 2px;
    background: var(--line-strong);
  }

  .filter button {
    flex: none;
    padding: 0.4rem 0;
    border: 0;
    background: none;
    color: var(--ink-soft);
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s;
  }

  .filter button:hover,
  .filter button[aria-pressed='true'] {
    color: var(--ink);
  }

  .filter button[aria-pressed='true'] {
    font-weight: 700;
  }

  .knob {
    position: absolute;
    bottom: 0;
    left: -8px;
    width: 16px;
    height: 16px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--accent);
    transform: translateX(var(--x, 0px));
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* The shelf: 1 cover per row on phones, 2 on tablets, 3 on desktop */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: clamp(2.5rem, 5vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .empty {
    padding-block: 3rem;
    font-size: 1.25rem;
  }
</style>
<script>
  // 1. The hero animation (the ruler and the knob) lives in its own file.
  import '../scripts/hero-ruler';

  // 2. Category filter: shows or hides cards by their data-category, and slides the knob.
  // Without JavaScript the buttons stay hidden and every card stays visible.
  const bar = document.querySelector<HTMLElement>('[data-filter]');

  if (bar) {
    const buttons = bar.querySelectorAll<HTMLButtonElement>('button[data-category]');
    const cards = document.querySelectorAll<HTMLElement>('[data-card]');
    const knob = bar.querySelector<HTMLElement>('.knob');
    const status = document.querySelector<HTMLElement>('[data-filter-status]');

    const moveKnob = (button: HTMLElement) => {
      knob?.style.setProperty('--x', `${button.offsetLeft + button.offsetWidth / 2}px`);
    };

    const current = () => bar.querySelector<HTMLButtonElement>('button[aria-pressed="true"]');

    bar.hidden = false;
    moveKnob(buttons[0]);
    // Place it again once the font has loaded and the tab widths are final
    document.fonts.ready.then(() => {
      const pressed = current();
      if (pressed) moveKnob(pressed);
    });
    window.addEventListener('resize', () => {
      const pressed = current();
      if (pressed) moveKnob(pressed);
    });

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const chosen = button.dataset.category;
        let shown = 0;

        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        moveKnob(button);

        cards.forEach((card) => {
          const match = chosen === 'all' || card.dataset.category === chosen;
          card.hidden = !match;
          if (match) shown++;
        });

        if (status) {
          status.textContent = `Showing ${shown} of ${cards.length} topics`;
        }
      });
    });
  }
</script>
