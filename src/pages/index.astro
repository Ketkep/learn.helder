---
// Homepage: hero, category filter and the topic grid. The grid is built from
// src/data/topics.ts, so nothing here changes when a topic is added.
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/TopicCard.astro';
import { getVisibleTopics, getCategories, getTopicNumber } from '../data/topics';

const topics = getVisibleTopics();
const categories = getCategories();
---

<BaseLayout
  title="Helder Labs Learn: interactive explainers"
  description="Interactive explainers from Helder Labs. Learn things by playing with them."
  band="var(--hero-tint)"
>
  <section class="hero">
    <div class="wrap hero-inner">
      <h1 class="hero-title">
        <span>Helder Labs</span>
        <span class="learn">Learn</span>
      </h1>
      <p class="lede">
        <span>Interactive explainers.</span>
        <span>Learn things by playing with them.</span>
      </p>
    </div>

    <!-- One segment per topic, in the topic's own color -->
    {
      topics.length > 0 && (
        <div class="strip" aria-hidden="true">
          {topics.map((t) => (
            <span style={`background: ${t.accent};`} />
          ))}
        </div>
      )
    }
  </section>

  <section class="topics wrap" aria-labelledby="topics-heading">
    <h2 id="topics-heading" class="visually-hidden">Topics</h2>

    {
      categories.length > 1 && (
        <div class="filter" role="group" aria-label="Filter topics by category" data-filter hidden>
          <button type="button" data-category="all" aria-pressed="true">All</button>
          {categories.map((c) => (
            <button type="button" data-category={c} aria-pressed="false">
              {c}
            </button>
          ))}
        </div>
      )
    }
    <p class="visually-hidden" role="status" data-filter-status></p>

    {
      topics.length > 0 ? (
        <div class="grid">
          {topics.map((t) => (
            <TopicCard topic={t} number={getTopicNumber(t.slug)} />
          ))}
        </div>
      ) : (
        <p class="empty">The first explainers are on their way.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--band);
  }

  .hero-inner {
    display: grid;
    gap: 1.5rem 3rem;
    padding-block: clamp(1rem, 3.5vw, 2.5rem) clamp(2rem, 5vw, 3.5rem);
  }

  .hero-title {
    font-size: clamp(3.4rem, 12.5vw, 7.25rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.02em;
  }

  .hero-title span {
    display: block;
  }

  .learn {
    color: var(--accent);
  }

  .lede {
    max-width: 23rem;
    color: var(--ink-soft);
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.3rem);
    line-height: 1.4;
  }

  .lede span {
    display: block;
  }

  /* "Helder" means clear: the name comes into focus when the page loads */
  @media (prefers-reduced-motion: no-preference) {
    .hero-title {
      animation: come-into-focus 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
  }

  @keyframes come-into-focus {
    from {
      filter: blur(14px);
      opacity: 0;
    }

    to {
      filter: blur(0);
      opacity: 1;
    }
  }

  /* Title on the left, one-line description pinned to the bottom right */
  @media (min-width: 52rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) 23rem;
      align-items: end;
    }

    .lede {
      padding-bottom: 0.8rem;
    }
  }

  /* A thin color index: one segment per topic */
  .strip {
    display: flex;
    height: 4px;
  }

  .strip span {
    flex: 1;
  }

  .topics {
    padding-top: clamp(1rem, 3vw, 1.75rem);
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--line);
  }

  .filter button {
    margin-bottom: -1px;
    padding: 0.7rem 0;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--ink-soft);
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .filter button:hover {
    color: var(--ink);
  }

  .filter button[aria-pressed='true'] {
    border-bottom-color: var(--accent);
    color: var(--ink);
    font-weight: 600;
  }

  /* Auto-fills columns: 1 on phones, 2 on tablets, 3 on desktop */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: clamp(2.5rem, 5vw, 3.5rem) clamp(1.5rem, 3vw, 2.25rem);
  }

  .empty {
    padding-block: 3rem;
    font-size: 1.25rem;
  }
</style>

<script>
  // Category filter: shows or hides cards by their data-category.
  // Without JavaScript the buttons stay hidden and every card stays visible.
  const bar = document.querySelector<HTMLElement>('[data-filter]');

  if (bar) {
    const buttons = bar.querySelectorAll<HTMLButtonElement>('button[data-category]');
    const cards = document.querySelectorAll<HTMLElement>('[data-card]');
    const status = document.querySelector<HTMLElement>('[data-filter-status]');

    bar.hidden = false;

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const chosen = button.dataset.category;
        let shown = 0;

        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));

        cards.forEach((card) => {
          const match = chosen === 'all' || card.dataset.category === chosen;
          card.hidden = !match;
          if (match) shown++;
        });

        if (status) {
          status.textContent = `Showing ${shown} of ${cards.length} topics`;
        }
      });
    });
  }
</script>
