---
// The home page: today's discovery. The page is built once, but the day is worked out in the browser
// (Europe/Amsterdam, see src/lib/daily.ts), so a new edition shows up at midnight without a rebuild.
// The build day's edition is in the HTML, so the page also works without a script.
import BaseLayout from '../layouts/BaseLayout.astro';
import { DAILY, dayAt } from '../lib/daily';
import { pickToday } from '../lib/schedule';
import { editionCards } from '../components/daily/meta';
import { getVisibleTopics } from '../data/topics';
import '../styles/daily.css';

const cards = editionCards();
const buildDay = dayAt(Date.now());
const pick = pickToday(cards, buildDay);
const hero = pick.kind === 'today' ? pick.edition : pick.kind === 'gap' ? pick.latest : pick.kind === 'soon' ? pick.next : undefined;
const label = pick.kind === 'today' ? 'Today’s discovery' : pick.kind === 'gap' ? 'The most recent discovery' : 'The first discovery';
const libraryCount = getVisibleTopics().length;
---

<BaseLayout
  title={`${DAILY.name}: one small discovery a day | Helder Labs Learn`}
  description="One short interactive discovery a day, the same for everyone. Guess first, try it, find out why, then use it. About seven minutes."
  nav="today"
  image={hero?.preview}
  imageAlt={hero ? `${hero.title}. ${hero.question}` : undefined}
>
  <div class="today" data-today data-cards={JSON.stringify(cards)}>
    <section class="wrap today-top" aria-labelledby="today-title">
      <p class="today-brand">
        <svg viewBox="0 0 28 24" width="28" height="24" aria-hidden="true" focusable="false">
          <path d="M2 12h24" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          <circle cx="18" cy="12" r="6" fill="var(--accent)" stroke="currentColor" stroke-width="2"></circle>
        </svg>
        <span class="today-name">{DAILY.name}</span>
        <span class="today-tagline">One small discovery a day</span>
      </p>

      <p class="today-banner" data-banner hidden></p>

      {
        hero && (
          <article class="today-card" data-hero style={`--ed: ${hero.accent}; --ed-ink: ${hero.ink};`}>
            <div class="today-card-text">
              <p class="today-kicker">
                <span data-hero-label>{label}</span>
                <span>
                  No. <span data-hero-number>{hero.number}</span>
                </span>
                <span data-hero-date>{hero.dateLabel}</span>
              </p>
              <h1 class="today-title" id="today-title" data-hero-title>
                {hero.title}
              </h1>
              <p class="today-question" data-hero-question>
                {hero.question}
              </p>
              <p class="today-teaser" data-hero-teaser>
                {hero.teaser}
              </p>
              <p class="today-meta">
                <span>
                  About <span data-hero-minutes>{hero.minutes}</span> minutes
                </span>
                <span data-hero-subject>{hero.subject}</span>
                <span>Guess, try, find out, use it</span>
              </p>
              <div class="today-actions">
                <a class="ed-btn ed-btn-big" href={hero.path} data-hero-link>
                  <span data-hero-cta>{pick.kind === 'soon' ? 'See when it opens' : 'Start the discovery'}</span>
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
                <p class="today-status" data-hero-status aria-live="polite" />
              </div>
            </div>
            <img class="today-cover" src={hero.cover} alt="" width="480" height="360" data-hero-cover />
          </article>
        )
      }

      <div class="today-strip needs-js">
        <p class="today-streak" data-streak></p>
        <p class="today-next" data-next></p>
        <details class="today-rule">
          <summary>How the streak is counted</summary>
          <p>A day counts when you finish that day’s discovery on that day, Amsterdam time. Days without a discovery do not break a streak. Finishing an older one from the archive marks it done, but it does not add to the streak. Your progress stays in this browser only: there is no account, and nothing is sent anywhere.</p>
        </details>
      </div>
    </section>

    <section class="wrap today-recent" aria-labelledby="recent-title" data-recent-wrap>
      <h2 id="recent-title">Earlier discoveries</h2>
      <ol class="arch-list" data-recent>
        {
          [...cards].reverse().map((c) => (
            <li class="arch-item" data-arch={c.number} data-date={c.date} hidden={c.date >= buildDay} style={`--ed: ${c.accent};`}>
              <a href={c.path}>
                <img src={c.cover} alt="" width="160" height="120" loading="lazy" />
                <span class="arch-text">
                  <span class="arch-kicker">
                    No. {c.number} · {c.dateLabel}
                  </span>
                  <span class="arch-title">{c.title}</span>
                  <span class="arch-status" data-arch-status />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="today-empty" data-recent-empty hidden={cards.some((c) => c.date < buildDay)}>The archive starts filling up tomorrow. Every discovery stays here after its day.</p>
      <p><a class="ed-link" href="/archive/">All editions</a></p>
    </section>

    <section class="wrap today-library" aria-labelledby="library-title">
      <div>
        <h2 id="library-title">The library</h2>
        <p>{libraryCount} longer explainers on science, history, technology, language and more, to explore at your own pace. They are separate from the daily discoveries. Some discoveries started out as one of them.</p>
      </div>
      <p><a class="ed-btn ed-btn-quiet" href="/library/">Browse the library</a></p>
    </section>
  </div>
</BaseLayout>

<script>
  import '../scripts/daily/today';
</script>
